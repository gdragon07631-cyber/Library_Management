# Local staging only. Replace these placeholders before use; do not expose this stack publicly as-is.
MSSQL_SA_PASSWORD=ReplaceMe_Staging_2026!
JWT_SIGNING_KEY=ReplaceWithRandomSecretAtLeast32Bytes_StagingOnly

# Optional: leave EMAIL_* blank to disable outbound email-dependent flows.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_ENABLE_SSL=true
EMAIL_FROM=
EMAIL_USERNAME=
EMAIL_PASSWORD=

# Optional host ports; change them if the defaults are already in use.
STAGING_HTTP_PORT=5188
STAGING_SQL_PORT=1433
