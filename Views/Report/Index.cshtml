@using System.Text.Json
@model Project.Models.LoanReportPageViewModel
@{
    ViewData["Title"] = "Báo cáo mượn trả";
    var initialDailyLoans = JsonSerializer.Serialize(Model.DailyLoans.Select(row => new
    {
        date = row.Date.ToString("yyyy-MM-dd"),
        loanCount = row.LoanCount
    }));
}
<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 mb-1 text-primary fw-bold">Báo cáo thư viện</h1>
        <p class="text-muted mb-0">Tổng quan mượn trả, xu hướng lượt mượn và các bảng xếp hạng.</p>
    </div>
    <div class="alert alert-warning" role="note"><strong>Lưu ý thực hành:</strong> năm thẻ tổng quan dùng dữ liệu minh họa. Biểu đồ và hai bảng xếp hạng lấy dữ liệu thật từ database.</div>

    <form id="reportFilter" class="card card-body shadow-sm border-0 mb-4" novalidate>
        <div class="row g-3 align-items-end">
            <div class="col-sm-5 col-md-4"><label for="startDate" class="form-label">Từ ngày</label><input id="startDate" class="form-control" type="date" value="@Model.Summary.StartDate.ToString("yyyy-MM-dd")" required /></div>
            <div class="col-sm-5 col-md-4"><label for="endDate" class="form-label">Đến ngày</label><input id="endDate" class="form-control" type="date" value="@Model.Summary.EndDate.ToString("yyyy-MM-dd")" required /></div>
            <div class="col-sm-2"><button class="btn btn-primary w-100" type="submit">Xem báo cáo</button></div>
        </div>
    </form>
    <div id="reportMessage" class="alert d-none" role="status" aria-live="polite"></div>

    <div class="row g-3 mb-4" id="reportCards" aria-live="polite">
        <div class="col-md-6 col-xl"><div class="card h-100 shadow-sm border-0"><div class="card-body"><div class="text-muted small">Tổng lượt mượn</div><div class="display-6 fw-semibold" data-metric="totalLoans">@Model.Summary.TotalLoans</div></div></div></div>
        <div class="col-md-6 col-xl"><div class="card h-100 shadow-sm border-0"><div class="card-body"><div class="text-muted small">Tổng lượt trả</div><div class="display-6 fw-semibold" data-metric="totalReturns">@Model.Summary.TotalReturns</div></div></div></div>
        <div class="col-md-6 col-xl"><div class="card h-100 shadow-sm border-0"><div class="card-body"><div class="text-muted small">Phiếu đang mở</div><div class="display-6 fw-semibold" data-metric="openLoans">@Model.Summary.OpenLoans</div></div></div></div>
        <div class="col-md-6 col-xl"><div class="card h-100 shadow-sm border-0"><div class="card-body"><div class="text-muted small">Phiếu quá hạn</div><div class="display-6 fw-semibold" data-metric="overdueLoans">@Model.Summary.OverdueLoans</div></div></div></div>
        <div class="col-md-6 col-xl"><div class="card h-100 shadow-sm border-0"><div class="card-body"><div class="text-muted small">Tỷ lệ quá hạn</div><div class="display-6 fw-semibold"><span data-metric="overdueRate">@Model.Summary.OverdueRate.ToString("0.##")</span>%</div></div></div></div>
    </div>

    <section class="card shadow-sm border-0 mb-4" aria-labelledby="dailyChartTitle">
        <div class="card-header bg-white"><h2 id="dailyChartTitle" class="h5 mb-0">Lượt mượn theo ngày</h2></div>
        <div class="card-body">
            <p class="small text-muted">Trục ngang: ngày · Trục dọc: số lượt mượn</p>
            <div id="dailyChartMessage" class="small text-muted mb-2" role="status" aria-live="polite"></div>
            <div class="overflow-auto">
                <svg id="dailyLoansChart" role="img" aria-labelledby="dailyChartTitle dailyChartDescription" class="d-block">
                    <desc id="dailyChartDescription">Biểu đồ cột số lượt mượn trong từng ngày của khoảng đã chọn.</desc>
                </svg>
            </div>
        </div>
    </section>

    <section class="card shadow-sm border-0 mb-4" aria-labelledby="loanRankingTitle">
        <div class="card-header bg-white"><h2 id="loanRankingTitle" class="h5 mb-0">10 đầu sách được mượn nhiều nhất</h2></div>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th scope="col">Hạng</th><th scope="col">Tên đầu sách</th><th scope="col">Lượt mượn</th><th scope="col">Tổng bản sao vật lý</th></tr></thead>
            <tbody id="loanRankingRows">
                @if (Model.TopBooks.Count == 0)
                {
                    <tr><td colspan="4" class="text-center text-muted py-4">Không có đầu sách phát sinh lượt mượn trong khoảng thời gian đã chọn.</td></tr>
                }
                else
                {
                    foreach (var row in Model.TopBooks)
                    {
                        <tr><td>@row.Rank</td><td>@row.BookTitle</td><td>@row.LoanCount</td><td>@row.PhysicalCopyCount</td></tr>
                    }
                }
            </tbody>
        </table></div>
    </section>

    <section class="card shadow-sm border-0" aria-labelledby="holdRankingTitle">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <h2 id="holdRankingTitle" class="h5 mb-0">10 đầu sách có hàng đợi đặt giữ dài nhất</h2>
            <span class="small text-muted">Ảnh chụp hàng đợi hiện tại, không phụ thuộc khoảng ngày</span>
        </div>
        <div class="table-responsive"><table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th scope="col">Hạng</th><th scope="col">Tên đầu sách</th><th scope="col">Yêu cầu đang chờ</th></tr></thead>
            <tbody id="holdRankingRows">
                @if (Model.TopHeldBooks.Count == 0)
                {
                    <tr><td colspan="3" class="text-center text-muted py-4">Hiện không có đầu sách nào có hàng đợi đặt giữ.</td></tr>
                }
                else
                {
                    foreach (var row in Model.TopHeldBooks)
                    {
                        <tr><td>@row.Rank</td><td>@row.BookTitle</td><td>@row.PendingHoldCount</td></tr>
                    }
                }
            </tbody>
        </table></div>
    </section>
</div>
<script id="initialDailyLoans" type="application/json">@Html.Raw(initialDailyLoans)</script>
@section Scripts {
<script>
(() => {
    const form = document.getElementById('reportFilter');
    const message = document.getElementById('reportMessage');
    const chartMessage = document.getElementById('dailyChartMessage');
    const start = document.getElementById('startDate');
    const end = document.getElementById('endDate');
    const chart = document.getElementById('dailyLoansChart');
    const loanRows = document.getElementById('loanRankingRows');
    const holdRows = document.getElementById('holdRankingRows');
    const svgNs = 'http://www.w3.org/2000/svg';
    const svgNode = (tag, attrs, text) => {
        const node = document.createElementNS(svgNs, tag);
        for (const [key, value] of Object.entries(attrs || {})) node.setAttribute(key, value);
        if (text !== undefined) node.textContent = text;
        return node;
    };
    const showMessage = (target, text, kind) => {
        target.textContent = text;
        target.className = kind ? `alert alert-${kind}` : 'small text-muted mb-2';
    };
    const renderRows = (target, items, emptyText, fields, colspan) => {
        target.replaceChildren();
        if (items.length === 0) {
            const tr = document.createElement('tr');
            const td = document.createElement('td');
            td.colSpan = colspan;
            td.className = 'text-center text-muted py-4';
            td.textContent = emptyText;
            tr.append(td);
            target.append(tr);
            return;
        }
        for (const item of items) {
            const tr = document.createElement('tr');
            for (const field of fields) {
                const td = document.createElement('td');
                td.textContent = item[field];
                tr.append(td);
            }
            target.append(tr);
        }
    };
    const renderChart = data => {
        chart.replaceChildren();
        const description = svgNode('desc', { id: 'dailyChartDescription' }, 'Biểu đồ cột số lượt mượn trong từng ngày của khoảng đã chọn.');
        chart.append(description);
        if (!data.length) {
            chartMessage.textContent = 'Không có dữ liệu ngày để hiển thị.';
            return;
        }
        const width = Math.max(960, data.length * 42);
        const height = 390;
        const left = 62, right = 22, top = 22, bottom = 74;
        const plotWidth = width - left - right;
        const plotHeight = height - top - bottom;
        const maxValue = Math.max(1, ...data.map(item => Math.max(0, item.loanCount)));
        const tickStep = Math.max(1, Math.ceil(maxValue / 4));
        const yMax = tickStep * 4;
        chart.setAttribute('viewBox', `0 0 ${width} ${height}`);
        chart.setAttribute('width', width);
        chart.setAttribute('height', height);
        chart.style.width = `${width}px`;
        for (let tick = 0; tick <= 4; tick++) {
            const value = tick * tickStep;
            const y = top + plotHeight - (value / yMax) * plotHeight;
            chart.append(svgNode('line', { x1: left, y1: y, x2: width - right, y2: y, stroke: '#dee2e6', 'stroke-width': 1 }));
            chart.append(svgNode('text', { x: left - 10, y: y + 4, 'text-anchor': 'end', fill: '#6c757d', 'font-size': 12 }, String(value)));
        }
        chart.append(svgNode('line', { x1: left, y1: top, x2: left, y2: top + plotHeight, stroke: '#6c757d', 'stroke-width': 1 }));
        chart.append(svgNode('line', { x1: left, y1: top + plotHeight, x2: width - right, y2: top + plotHeight, stroke: '#6c757d', 'stroke-width': 1 }));
        chart.append(svgNode('text', { x: 18, y: top + plotHeight / 2, transform: `rotate(-90 18 ${top + plotHeight / 2})`, 'text-anchor': 'middle', fill: '#495057', 'font-size': 13 }, 'Số lượt mượn'));
        chart.append(svgNode('text', { x: left + plotWidth / 2, y: height - 8, 'text-anchor': 'middle', fill: '#495057', 'font-size': 13 }, 'Ngày'));
        const slot = plotWidth / data.length;
        const barWidth = Math.max(1, slot * 0.68);
        data.forEach((item, index) => {
            const count = Math.max(0, item.loanCount);
            const barHeight = (count / yMax) * plotHeight;
            const x = left + index * slot + (slot - barWidth) / 2;
            const y = top + plotHeight - barHeight;
            const bar = svgNode('rect', { x, y, width: barWidth, height: barHeight, rx: 2, fill: '#0d6efd', tabindex: 0 });
            bar.append(svgNode('title', {}, `${item.date}: ${count} lượt mượn`));
            chart.append(bar);
            const dateLabel = new Intl.DateTimeFormat('vi-VN', { day: '2-digit', month: '2-digit' })
                .format(new Date(`${item.date}T12:00:00`));
            chart.append(svgNode('text', { x: left + index * slot + slot / 2, y: top + plotHeight + 20, transform: `rotate(-35 ${left + index * slot + slot / 2} ${top + plotHeight + 20})`, 'text-anchor': 'end', fill: '#6c757d', 'font-size': 11 }, dateLabel));
        });
        chartMessage.textContent = data.every(item => item.loanCount === 0)
            ? 'Không có lượt mượn trong khoảng thời gian đã chọn; các ngày được hiển thị với giá trị 0.'
            : 'Di chuột hoặc di chuyển tiêu điểm tới cột để xem ngày và số lượt mượn.';
    };
    const setLoadingRow = (target, colspan, text) => renderRows(target, [], text, [], colspan);
    const showNoDataAfterError = () => {
        for (const key of ['totalLoans', 'totalReturns', 'openLoans', 'overdueLoans', 'overdueRate'])
            document.querySelector(`[data-metric="${key}"]`).textContent = '—';
        renderChart([]);
        setLoadingRow(loanRows, 4, 'Không thể tải dữ liệu xếp hạng.');
        setLoadingRow(holdRows, 3, 'Không thể tải dữ liệu hàng đợi.');
    };

    renderChart(JSON.parse(document.getElementById('initialDailyLoans').textContent));
    form.addEventListener('submit', async event => {
        event.preventDefault();
        if (!start.value || !end.value || start.value > end.value) {
            showMessage(message, 'Vui lòng chọn khoảng ngày hợp lệ; ngày bắt đầu không được sau ngày kết thúc.', 'danger');
            return;
        }
        const button = form.querySelector('button[type="submit"]');
        button.disabled = true;
        for (const key of ['totalLoans', 'totalReturns', 'openLoans', 'overdueLoans', 'overdueRate'])
            document.querySelector(`[data-metric="${key}"]`).textContent = '…';
        setLoadingRow(loanRows, 4, 'Đang tải bảng xếp hạng mượn…');
        setLoadingRow(holdRows, 3, 'Đang tải hàng đợi đặt giữ…');
        chart.replaceChildren(svgNode('desc', { id: 'dailyChartDescription' }, 'Đang tải biểu đồ lượt mượn theo ngày.'));
        chartMessage.textContent = 'Đang tải biểu đồ…';
        showMessage(message, 'Đang tải báo cáo…', 'info');
        try {
            const query = new URLSearchParams({ startDate: start.value, endDate: end.value });
            const [summaryResponse, loansResponse, holdsResponse, dailyResponse] = await Promise.all([
                fetch(`/api/reports/loans/summary?${query}`, { headers: { 'Accept': 'application/json' } }),
                fetch(`/api/reports/loans/top-books?${query}`, { headers: { 'Accept': 'application/json' } }),
                fetch('/api/reports/holds/top-books', { headers: { 'Accept': 'application/json' } }),
                fetch(`/api/reports/loans/daily?${query}`, { headers: { 'Accept': 'application/json' } })
            ]);
            const [summary, books, holds, daily] = await Promise.all([
                summaryResponse.json(), loansResponse.json(), holdsResponse.json(), dailyResponse.json()
            ]);
            if (!summaryResponse.ok) throw new Error(summary.message || 'Không thể tải số liệu tổng quan.');
            if (!loansResponse.ok) throw new Error(books.message || 'Không thể tải bảng xếp hạng mượn.');
            if (!holdsResponse.ok) throw new Error(holds.message || 'Không thể tải hàng đợi đặt giữ.');
            if (!dailyResponse.ok) throw new Error(daily.message || 'Không thể tải biểu đồ lượt mượn.');
            for (const key of ['totalLoans', 'totalReturns', 'openLoans', 'overdueLoans', 'overdueRate']) {
                document.querySelector(`[data-metric="${key}"]`).textContent = key === 'overdueRate'
                    ? Number(summary[key]).toLocaleString('vi-VN', { maximumFractionDigits: 2 })
                    : summary[key];
            }
            renderRows(loanRows, books, 'Không có đầu sách phát sinh lượt mượn trong khoảng thời gian đã chọn.',
                ['rank', 'bookTitle', 'loanCount', 'physicalCopyCount'], 4);
            renderRows(holdRows, holds, 'Hiện không có đầu sách nào có hàng đợi đặt giữ.',
                ['rank', 'bookTitle', 'pendingHoldCount'], 3);
            renderChart(daily);
            showMessage(message, 'Đã cập nhật báo cáo theo khoảng ngày đã chọn. Bảng đặt giữ là snapshot hiện tại.', 'success');
        } catch (error) {
            showNoDataAfterError();
            showMessage(message, error.message || 'Có lỗi khi tải báo cáo. Vui lòng thử lại.', 'danger');
        } finally {
            button.disabled = false;
        }
    });
})();
</script>
}
