@model IReadOnlyList<Project.Models.Book>
@{
    ViewData["Title"] = "Danh mục sách";
    var copyCounts = ViewData["CopyCounts"] as IReadOnlyDictionary<int, int> ?? new Dictionary<int, int>();
    var currentPage = ViewData["Page"] as int? ?? 1;
    var pageSize = ViewData["PageSize"] as int? ?? 20;
    var totalItems = ViewData["TotalItems"] as int? ?? Model.Count;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
    var searchKeyword = ViewData["SearchKeyword"] as string;
    var startItem = totalItems == 0 ? 0 : (currentPage - 1) * pageSize + 1;
    var endItem = Math.Min(currentPage * pageSize, totalItems);
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 text-primary font-weight-bold">Danh mục Sách</h1>
            <p class="text-muted mb-0">Danh sách các đầu sách đã được biên mục trong hệ thống thư viện</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                + Biên mục sách mới
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div class="d-flex align-items-center gap-2">
                    <h2 class="h5 mb-0 fw-semibold text-secondary">Danh sách Sách đã biên mục</h2>
                    <span class="badge bg-primary rounded-pill">Tổng số: @totalItems</span>
                </div>
                <form asp-action="Index" method="get" class="d-flex flex-wrap align-items-center gap-2 m-0">
                    <input type="hidden" name="page" value="1" />
                    <div class="input-group input-group-sm" style="width: 280px;">
                        <input type="search" name="q" value="@searchKeyword" class="form-control" placeholder="Tìm nhan đề, ISBN, tác giả..." />
                        <button type="submit" class="btn btn-outline-primary">Tìm</button>
                        @if (!string.IsNullOrWhiteSpace(searchKeyword))
                        {
                            <a asp-action="Index" asp-route-pageSize="@pageSize" class="btn btn-outline-secondary">Xóa</a>
                        }
                    </div>
                    <select name="pageSize" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()" aria-label="Số dòng mỗi trang">
                        <option value="10" selected="@(pageSize == 10)">10 / trang</option>
                        <option value="20" selected="@(pageSize == 20)">20 / trang</option>
                        <option value="50" selected="@(pageSize == 50)">50 / trang</option>
                    </select>
                </form>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="booksTable">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 60px;" class="text-center">STT</th>
                            <th scope="col" style="width: 90px;" class="text-center">Bìa</th>
                            <th scope="col">Nhan đề</th>
                            <th scope="col">ISBN</th>
                            <th scope="col">Tác giả</th>
                            <th scope="col">Nhà xuất bản</th>
                            <th scope="col" class="text-center">Năm XB</th>
                            <th scope="col">Thể loại</th>
                            <th scope="col" class="text-center">Số trang</th>
                            <th scope="col" style="width: 140px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4 text-muted">
                                    @if (!string.IsNullOrWhiteSpace(searchKeyword))
                                    {
                                        <span>Không tìm thấy đầu sách nào khớp với từ khóa <strong>"@searchKeyword"</strong>.</span>
                                    }
                                    else
                                    {
                                        <span>Chưa có cuốn sách nào được biên mục. Hãy nhấn <strong>Biên mục sách mới</strong> để thêm.</span>
                                    }
                                </td>
                            </tr>
                        }
                        else
                        {
                            var index = startItem;
                            foreach (var book in Model)
                            {
                                <tr>
                                    <td class="text-center text-muted">@index</td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@book.Id" aria-label="Mở chi tiết @book.Title">
                                            <img src="@Project.Models.BookCoverPresentation.ForList(book)"
                                                 alt="Bìa sách @book.Title" class="book-cover-thumbnail" loading="lazy" />
                                        </a>
                                    </td>
                                    <td class="fw-medium text-dark">
                                        <a asp-action="Details" asp-route-id="@book.Id" class="text-decoration-none">
                                            @book.Title
                                        </a>
                                        @if (!string.IsNullOrWhiteSpace(book.Subtitle))
                                        {
                                            <div class="small text-muted">@book.Subtitle</div>
                                        }
                                        @if (copyCounts.GetValueOrDefault(book.Id) == 0)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle mt-1" data-status="no-copies">@Project.Models.BookCatalogStatus.NoCopies</span>
                                        }
                                    </td>
                                    <td class="text-muted small">@(string.IsNullOrWhiteSpace(book.Isbn) ? "-" : book.Isbn)</td>
                                    <td>
                                        @foreach (var author in Project.Models.BookAuthorList.For(book))
                                        {
                                            <div>
                                                <span class="fw-semibold">@author.Name</span>
                                                @if (author.Status == Project.Models.AuthorStatus.Inactive)
                                                {
                                                    <span class="badge bg-secondary ms-1 small">Ngừng sử dụng</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(book.Publisher) ? "-" : book.Publisher)</td>
                                    <td class="text-center">@(book.PublicationYear?.ToString() ?? "-")</td>
                                    <td>@(book.Category == null ? "-" : book.Category.Parent == null ? book.Category.Name : $"{book.Category.Parent.Name} > {book.Category.Name}")</td>
                                    <td class="text-center">@(book.PageCount?.ToString() ?? "-")</td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-primary">
                                            Chi tiết
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-secondary mt-1">
                                            Sửa
                                        </a>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
        @if (totalItems > 0)
        {
            <div class="card-footer bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="small text-muted">
                    Hiển thị <strong>@startItem – @endItem</strong> trong tổng số <strong>@totalItems</strong> đầu sách (Trang @currentPage / @totalPages)
                </div>
                @if (totalPages > 1)
                {
                    <nav aria-label="Phân trang danh mục sách">
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize" asp-route-q="@searchKeyword" aria-label="Trang trước">‹ Trước</a>
                            </li>
                            @{
                                var startPage = Math.Max(1, currentPage - 2);
                                var endPage = Math.Min(totalPages, startPage + 4);
                                if (endPage - startPage < 4)
                                {
                                    startPage = Math.Max(1, endPage - 4);
                                }
                            }
                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-route-page="1" asp-route-pageSize="@pageSize" asp-route-q="@searchKeyword">1</a>
                                </li>
                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">…</span></li>
                                }
                            }
                            @for (var p = startPage; p <= endPage; p++)
                            {
                                <li class="page-item @(p == currentPage ? "active" : "")">
                                    <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-pageSize="@pageSize" asp-route-q="@searchKeyword" aria-current="@(p == currentPage ? "page" : null)">@p</a>
                                </li>
                            }
                            @if (endPage < totalPages)
                            {
                                @if (endPage < totalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">…</span></li>
                                }
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index" asp-route-page="@totalPages" asp-route-pageSize="@pageSize" asp-route-q="@searchKeyword">@totalPages</a>
                                </li>
                            }
                            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                                <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize" asp-route-q="@searchKeyword" aria-label="Trang sau">Sau ›</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        }
    </div>
</div>
