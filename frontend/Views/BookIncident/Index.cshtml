@model Project.Models.BookIncidentIndexViewModel
@{
    ViewData["Title"] = "Ghi nhận sách mất hoặc hỏng nặng";
}

<div class="container-fluid py-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 text-primary fw-bold">Ghi nhận sách mất hoặc hỏng nặng</h1>
            <p class="text-muted mb-0">Chọn phiếu mượn đang mở và bản sao sách gặp sự cố để loại khỏi kho thư viện.</p>
        </div>
        <div>
            <a asp-controller="CompensationPolicy" asp-action="Index" class="btn btn-outline-primary me-2">
                <span>⚙</span> Cấu hình hệ số bồi thường
            </a>
            <a asp-controller="Loan" asp-action="Index" class="btn btn-outline-secondary me-2">
                <span>⇄</span> Quản lý mượn trả
            </a>
            <a asp-controller="LoanReturn" asp-action="Index" class="btn btn-outline-secondary">
                <span>↩</span> Nhận trả sách
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <span class="me-2">✓</span> @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <span class="me-2">⚠</span> @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
        </div>
    }

    <div class="row g-4 mb-4">
        <!-- FORM GHI NHẬN SỰ CỐ -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom">
                    <h2 class="h5 mb-0 fw-bold text-dark">Phiếu ghi nhận sự cố</h2>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Record" method="post" enctype="multipart/form-data" id="recordIncidentForm">
                        @Html.AntiForgeryToken()

                        <!-- Chọn Phiếu mượn đang mở -->
                        <div class="mb-3">
                            <label asp-for="FormModel.LoanId" class="form-label fw-semibold">
                                Chọn phiếu mượn đang mở <span class="text-danger">*</span>
                            </label>
                            <select asp-for="FormModel.LoanId" id="loanSelect" class="form-select" required>
                                <option value="">-- Chọn phiếu mượn --</option>
                                @foreach (var loan in Model.OpenLoans)
                                {
                                    var isSelected = Model.SelectedLoanId == loan.LoanId;
                                    <option value="@loan.LoanId" selected="@isSelected"
                                            data-book="@loan.BookTitle"
                                            data-reader="@loan.ReaderName"
                                            data-card="@loan.CardCode"
                                            data-loandate="@loan.LoanDate.ToString("dd/MM/yyyy")"
                                            data-duedate="@loan.DueDate.ToString("dd/MM/yyyy")"
                                            data-duedate-raw="@loan.DueDate.ToString("yyyy-MM-dd")"
                                            data-copyid="@loan.BookCopyId"
                                            data-barcode="@loan.CopyBarcode">
                                        #@loan.LoanId - @loan.ReaderName (@loan.CardCode) - @loan.BookTitle
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="FormModel.LoanId" class="text-danger small"></span>
                        </div>

                        <!-- Thông tin phiếu mượn đã chọn -->
                        <div id="loanDetailsBox" class="alert alert-light border mb-3 @(Model.SelectedLoanId.HasValue ? "" : "d-none")">
                            <h6 class="fw-bold mb-2 text-primary">Chi tiết phiếu mượn</h6>
                            <div class="small">
                                <div><strong>Bạn đọc:</strong> <span id="detailReader">-</span></div>
                                <div><strong>Mã thẻ:</strong> <span id="detailCard">-</span></div>
                                <div><strong>Tên sách:</strong> <span id="detailBook">-</span></div>
                                <div><strong>Ngày mượn:</strong> <span id="detailLoanDate">-</span></div>
                                <div><strong>Hạn trả:</strong> <span id="detailDueDate">-</span></div>
                                <div class="mt-2 pt-2 border-top">
                                    <strong>Trạng thái trễ hạn & Phí phát sinh (Lát 3):</strong>
                                    <div id="detailOverdueInfo" class="mt-1 text-muted">-</div>
                                </div>
                            </div>
                        </div>

                        <!-- Chọn Bản sao sách -->
                        <div class="mb-3">
                            <label asp-for="FormModel.BookCopyId" class="form-label fw-semibold">
                                Bản sao sách gặp sự cố <span class="text-danger">*</span>
                            </label>
                            <select asp-for="FormModel.BookCopyId" id="copySelect" class="form-select" required>
                                <option value="">-- Chọn bản sao --</option>
                                @foreach (var copy in Model.SelectedLoanCopies)
                                {
                                    var isSelected = Model.FormModel.BookCopyId == copy.CopyId;
                                    <option value="@copy.CopyId" selected="@isSelected"
                                            data-coverprice="@(copy.CoverPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")">
                                        @copy.CopyBarcode (Kệ: @copy.ShelfName - Tình trạng: @copy.PhysicalCondition) - Giá bìa: @(copy.CoverPrice.HasValue ? copy.CoverPrice.Value.ToString("N0") + " VNĐ" : "Chưa có")
                                    </option>
                                }
                            </select>
                            <span asp-validation-for="FormModel.BookCopyId" class="text-danger small"></span>
                            <div class="form-text">Chỉ bản sao thuộc phiếu mượn được chọn mới được phép ghi nhận.</div>
                        </div>

                        <!-- Ước tính khoản bồi thường (Lát 2) -->
                        <div id="compensationPreviewBox" class="alert alert-info border mb-3 d-none">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <strong class="text-primary">Khoản bồi thường dự kiến (Lát 2)</strong>
                                <span class="badge bg-primary" id="policyRateBadge">Hệ số: 1.0x</span>
                            </div>
                            <div class="small" id="compensationPreviewText">-</div>
                        </div>

                        <!-- Chọn Tình trạng sự cố -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Tình trạng sự cố <span class="text-danger">*</span>
                            </label>
                            <div class="d-flex gap-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="FormModel.IncidentType" id="typeLost" value="@Project.Models.BookIncidentType.Lost" checked />
                                    <label class="form-check-label fw-semibold text-danger" for="typeLost">
                                        <span>✗</span> Mất
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="FormModel.IncidentType" id="typeDamaged" value="@Project.Models.BookIncidentType.Damaged" />
                                    <label class="form-check-label fw-semibold text-warning" for="typeDamaged">
                                        <span>⚠</span> Hỏng nặng
                                    </label>
                                </div>
                            </div>
                            <span asp-validation-for="FormModel.IncidentType" class="text-danger small"></span>
                        </div>

                        <!-- Nhập Mô tả tình trạng -->
                        <div class="mb-3">
                            <label asp-for="FormModel.Description" class="form-label fw-semibold">
                                Mô tả tình trạng cụ thể <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="FormModel.Description" id="incidentDescription" class="form-control" rows="3"
                                      placeholder="Ví dụ: Bạn đọc báo làm rơi mất sách trên xe buýt; hoặc sách bị rách nát hoàn toàn, ướt sũng..." required maxlength="1000"></textarea>
                            <span asp-validation-for="FormModel.Description" class="text-danger small"></span>
                            <div class="form-text">Mô tả chi tiết nguyên nhân, hiện trạng hư hỏng hoặc hoàn cảnh thất lạc.</div>
                        </div>

                        <!-- Đính kèm Ảnh chụp (tùy chọn) -->
                        <div class="mb-4">
                            <label asp-for="FormModel.Photo" class="form-label fw-semibold">
                                Ảnh chụp hiện trạng <span class="text-muted fw-normal">(Tùy chọn)</span>
                            </label>
                            <input type="file" asp-for="FormModel.Photo" id="incidentPhoto" class="form-control" accept=".jpg,.jpeg,.png,.webp" />
                            <div class="form-text">Chấp nhận JPG, PNG hoặc WEBP (tối đa 5MB).</div>
                            <div id="photoPreviewContainer" class="mt-2 d-none">
                                <img id="photoPreview" src="#" alt="Xem trước ảnh chụp" class="img-thumbnail" style="max-height: 150px;" />
                            </div>
                        </div>

                        <!-- Hành động submit -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger py-2 fw-semibold" id="btnSubmitIncident">
                                <span>✔</span> Xác nhận ghi nhận sự cố
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Làm mới</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- DANH SÁCH PHIẾU MƯỢN ĐANG MỞ -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0 fw-bold text-dark">Danh sách phiếu mượn đang mở</h2>
                    <span class="badge bg-primary rounded-pill">@Model.OpenLoans.Count phiếu</span>
                </div>
                <div class="table-responsive" style="max-height: 520px; overflow-y: auto;">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th>Mã phiếu</th>
                                <th>Bạn đọc</th>
                                <th>Đầu sách</th>
                                <th>Mã bản sao</th>
                                <th>Hạn trả</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.OpenLoans.Count == 0)
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">Hiện không có phiếu mượn nào đang mở.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var loan in Model.OpenLoans)
                                {
                                    <tr class="@(Model.SelectedLoanId == loan.LoanId ? "table-active" : "")">
                                        <td class="fw-bold">#@loan.LoanId</td>
                                        <td>
                                            <div class="fw-semibold">@loan.ReaderName</div>
                                            <small class="text-muted">@(loan.CardCode ?? "Chưa có thẻ")</small>
                                        </td>
                                        <td>
                                            <div class="text-truncate" style="max-width: 200px;" title="@loan.BookTitle">
                                                @loan.BookTitle
                                            </div>
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(loan.CopyBarcode))
                                            {
                                                <span class="badge bg-light text-dark border">@loan.CopyBarcode</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">Chưa gán</span>
                                            }
                                        </td>
                                        <td>
                                            <span class="@(loan.DueDate < DateOnly.FromDateTime(DateTime.Today) ? "text-danger fw-bold" : "")">
                                                @loan.DueDate.ToString("dd/MM/yyyy")
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <button type="button" class="btn btn-sm btn-outline-danger btn-select-loan"
                                                    data-loan-id="@loan.LoanId">
                                                Chọn ghi nhận
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- DANH SÁCH SỰ CỐ VỪA GHI NHẬN -->
    <div class="card border-0 shadow-sm mt-4">
        <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0 fw-bold text-dark">Sự cố sách đã ghi nhận gần đây</h2>
            <span class="text-muted small">Bản sao đã chuyển trạng thái sang <strong>Đã loại khỏi kho</strong></span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã sự cố</th>
                        <th>Loại sự cố</th>
                        <th>Bản sao sách</th>
                        <th>Phiếu mượn</th>
                        <th>Bạn đọc</th>
                        <th>Phí trễ hạn (Lát 3)</th>
                        <th>Khoản bồi thường (Lát 2)</th>
                        <th>Mô tả & Ảnh</th>
                        <th>Người ghi nhận</th>
                        <th>Thời gian</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentIncidents.Count == 0)
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted py-4">Chưa có sự cố nào được ghi nhận.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var inc in Model.RecentIncidents)
                        {
                            <tr>
                                <td class="fw-bold">#@inc.Id</td>
                                <td>
                                    @if (inc.IncidentType == Project.Models.BookIncidentType.Lost)
                                    {
                                        <span class="badge bg-danger">Mất</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Hỏng nặng</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-semibold">@(inc.BookCopy?.Book?.Title ?? "Chưa rõ")</div>
                                    <small class="text-muted">Mã: @(inc.BookCopy?.CopyCode ?? "-")</small>
                                </td>
                                <td>
                                    <div><strong class="text-dark">#@inc.BookLoanId</strong></div>
                                    @if (!string.IsNullOrEmpty(inc.BookLoan?.CloseReason))
                                    {
                                        <span class="badge bg-secondary" title="Đã đóng phiếu với lý do @inc.BookLoan.CloseReason">
                                            Đã đóng: @inc.BookLoan.CloseReason
                                        </span>
                                    }
                                    else if (inc.BookLoan?.ReturnedAtUtc.HasValue == true)
                                    {
                                        <span class="badge bg-secondary">Đã đóng</span>
                                    }
                                </td>
                                <td>@(inc.BookLoan?.ReaderAccount?.FullName ?? "-")</td>
                                <td>
                                    @if (inc.BookLoan != null && inc.BookLoan.OverdueFee > 0)
                                    {
                                        <div class="fw-bold text-danger">@inc.BookLoan.OverdueFee.ToString("N0") VNĐ</div>
                                        <div class="text-muted small" style="font-size: 0.8rem;">(2.000đ/ngày trễ)</div>
                                    }
                                    else
                                    {
                                        <div class="text-success fw-semibold">0 VNĐ</div>
                                        <div class="text-muted small" style="font-size: 0.78rem;">Đúng hạn</div>
                                    }
                                </td>
                                <td>
                                    @if (inc.Compensation != null)
                                    {
                                        <div>
                                            <span class="fw-bold fs-6 text-danger">@inc.Compensation.CurrentAmount.ToString("N0") VNĐ</span>
                                            @if (inc.Compensation.IsAdjusted)
                                            {
                                                <span class="badge bg-warning text-dark ms-1">Đã điều chỉnh</span>
                                            }
                                        </div>
                                        <div class="text-muted small" style="font-size: 0.8rem;">
                                            Giá bìa: @((inc.Compensation.RecordedCoverPrice ?? 0).ToString("N0")) VNĐ x @((inc.Compensation.AppliedRate ?? 1).ToString("0.##"))
                                        </div>
                                        @if (inc.Compensation.IsAdjusted)
                                        {
                                            <div class="small text-muted" style="font-size: 0.78rem;">
                                                Gốc: @inc.Compensation.InitialAmount.ToString("N0") VNĐ
                                                <br />
                                                <em>Lý do: @inc.Compensation.AdjustmentReason</em>
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic small">Không có khoản bồi thường (Thiếu giá bìa/hệ số)</span>
                                    }
                                </td>
                                <td>
                                    <div style="max-width: 220px;" class="text-break small mb-1">@inc.Description</div>
                                    @if (!string.IsNullOrEmpty(inc.PhotoPath))
                                    {
                                        <a href="@inc.PhotoPath" target="_blank" class="btn btn-xs btn-outline-info py-0 px-1" style="font-size: 0.75rem;">
                                            Xem ảnh
                                        </a>
                                    }
                                </td>
                                <td>
                                    <small class="d-block">@inc.ReportedBy</small>
                                    @if (inc.Compensation?.IsAdjusted == true && !string.IsNullOrEmpty(inc.Compensation.AdjustedBy))
                                    {
                                        <small class="text-muted d-block" style="font-size: 0.75rem;">Sửa bởi: @inc.Compensation.AdjustedBy</small>
                                    }
                                </td>
                                <td><small class="text-muted">@inc.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small></td>
                                <td class="text-end text-nowrap">
                                    <a asp-action="History" asp-route-loanId="@inc.BookLoanId" class="btn btn-sm btn-outline-secondary me-1" title="Xem lịch sử nghiệp vụ sự cố & bồi thường">
                                        <i class="bi bi-clock-history"></i> Lịch sử
                                    </a>
                                    @if (inc.IsReversed)
                                    {
                                        <span class="badge bg-secondary" title="Sự cố đã được đảo bằng bút toán điều chỉnh">Đã đảo nghiệp vụ</span>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-warning btn-reverse-incident me-1"
                                                data-incident-id="@inc.Id"
                                                data-summary="#@inc.Id - @(inc.BookCopy?.Book?.Title ?? "")"
                                                data-copy-code="@(inc.BookCopy?.CopyCode ?? "-")"
                                                data-incident-type="@inc.IncidentType"
                                                data-compensation="@(inc.Compensation?.CurrentAmount.ToString("N0") ?? "0") VNĐ">
                                            <i class="bi bi-arrow-counterclockwise"></i> Đảo
                                        </button>
                                        @if (inc.Compensation != null)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary btn-adjust-compensation"
                                                    data-incident-id="@inc.Id"
                                                    data-summary="#@inc.Id - @(inc.BookCopy?.Book?.Title ?? "")"
                                                    data-cover-price="@((inc.Compensation.RecordedCoverPrice ?? 0).ToString("N0")) VNĐ"
                                                    data-rate="@((inc.Compensation.AppliedRate ?? 1).ToString("0.##"))"
                                                    data-initial-amount="@inc.Compensation.InitialAmount.ToString("N0") VNĐ"
                                                    data-current-amount="@inc.Compensation.CurrentAmount.ToString("N0") VNĐ"
                                                    data-current-val="@inc.Compensation.CurrentAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                                    data-reason="@(inc.Compensation.AdjustmentReason ?? "")">
                                                Điều chỉnh
                                            </button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
    <!-- MODAL ĐIỀU CHỈNH KHOẢN BỒI THƯỜNG (LÁT 2) -->
    <div class="modal fade" id="adjustCompensationModal" tabindex="-1" aria-labelledby="adjustCompensationModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="AdjustCompensation" method="post" id="adjustCompensationForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IncidentId" id="modalIncidentId" value="" />
                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="adjustCompensationModalLabel">Điều chỉnh khoản bồi thường</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <div class="p-3 bg-light rounded border">
                                <div><strong>Sự cố:</strong> <span id="modalIncidentSummary">-</span></div>
                                <div><strong>Giá bìa ghi nhận:</strong> <span id="modalCoverPrice">-</span></div>
                                <div><strong>Hệ số áp dụng:</strong> <span id="modalRate">-</span></div>
                                <div><strong>Số tiền ban đầu:</strong> <span id="modalInitialAmount" class="fw-semibold text-secondary">-</span></div>
                                <div><strong>Số tiền hiện tại:</strong> <span id="modalCurrentAmount" class="fw-bold text-danger">-</span></div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="modalNewAmount" class="form-label fw-semibold">Số tiền bồi thường mới (VNĐ) <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" min="0" class="form-control" id="modalNewAmount" name="NewAmount" required />
                            <div class="form-text">Số tiền bồi thường sau điều chỉnh phải ≥ 0.</div>
                        </div>
                        <div class="mb-3">
                            <label for="modalReason" class="form-label fw-semibold">Lý do điều chỉnh <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="modalReason" name="Reason" rows="3" required maxlength="1000" placeholder="Nhập lý do điều chỉnh bắt buộc (ví dụ: Giảm bồi thường cho bạn đọc có hoàn cảnh khó khăn; sách đã qua sử dụng lâu năm...)"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary fw-semibold" id="btnConfirmAdjust">Lưu điều chỉnh</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- MODAL ĐẢO NGHIỆP VỤ BẰNG BÚT TOÁN ĐIỀU CHỈNH (LÁT 5) -->
    <div class="modal fade" id="reverseIncidentModal" tabindex="-1" aria-labelledby="reverseIncidentModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form asp-action="CreateAdjustmentVoucher" method="post" id="reverseIncidentForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="IncidentId" id="reverseModalIncidentId" value="" />
                    <div class="modal-header bg-light">
                        <h5 class="modal-title fw-bold text-danger" id="reverseIncidentModalLabel">
                            <i class="bi bi-arrow-counterclockwise"></i> Lập bút toán đảo / điều chỉnh sự cố (Lát 5)
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                    </div>
                    <div class="modal-body">
                        <div class="alert alert-warning d-flex align-items-center mb-3">
                            <i class="bi bi-exclamation-triangle-fill fs-4 me-2"></i>
                            <div>
                                <strong>Lưu ý quan trọng:</strong> Thao tác này sẽ lập bút toán điều chỉnh bất biến, khôi phục bản sao sách, hủy/điều chỉnh khoản bồi thường nhầm, nhưng <u>bảo toàn nguyên vẹn nhật ký gốc và phí trễ hạn</u> đã phát sinh. Bút toán sau khi lập sẽ không thể sửa hoặc xóa.
                            </div>
                        </div>

                        <div class="mb-3 p-3 bg-light rounded border">
                            <div class="row g-2">
                                <div class="col-md-6"><strong>Sự cố gốc:</strong> <span id="reverseModalSummary">-</span></div>
                                <div class="col-md-6"><strong>Mã bản sao:</strong> <span id="reverseModalCopyCode" class="badge bg-light text-dark border">-</span></div>
                                <div class="col-md-6"><strong>Loại sự cố:</strong> <span id="reverseModalType" class="badge bg-secondary">-</span></div>
                                <div class="col-md-6"><strong>Khoản bồi thường hiện tại:</strong> <span id="reverseModalCompensation" class="fw-bold text-danger">-</span></div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Phương án xử lý bản sao sách <span class="text-danger">*</span></label>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="CopyAction" id="actionRestoreToLoan" value="@Project.Models.CopyReversalActions.RestoreToLoan" checked>
                                <label class="form-check-label" for="actionRestoreToLoan">
                                    <strong>Khôi phục trạng thái Đang mượn (@Project.Models.CopyReversalActions.RestoreToLoan)</strong>
                                    <div class="text-muted small">Mở lại phiếu mượn, bản sao chuyển về trạng thái OnLoan (Dùng khi ghi nhận nhầm sự cố trong khi bạn đọc vẫn đang mượn sách).</div>
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="CopyAction" id="actionReturnToInventory" value="@Project.Models.CopyReversalActions.ReturnToInventory">
                                <label class="form-check-label" for="actionReturnToInventory">
                                    <strong>Nhập lại kho sẵn sàng (@Project.Models.CopyReversalActions.ReturnToInventory)</strong>
                                    <div class="text-muted small">Bản sao chuyển về trạng thái Available (tăng số bản rảnh), đóng phiếu mượn với lý do 'Đã trả' (Dùng khi tìm lại được sách hoặc bạn đọc mang sách đến trả).</div>
                                </label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="reverseModalReason" class="form-label fw-semibold">Lý do điều chỉnh / đảo nghiệp vụ <span class="text-danger">*</span></label>
                            <textarea class="form-control" id="reverseModalReason" name="Reason" rows="3" required minlength="5" maxlength="1000" placeholder="Ví dụ: Thủ thư ghi nhận nhầm mã vạch bản sao; bạn đọc đã tìm lại sách và đem trả nguyên vẹn..."></textarea>
                        </div>

                        <div class="mb-3">
                            <label for="reverseModalReferenceDocument" class="form-label fw-semibold">Tài liệu / Biên bản căn cứ <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="reverseModalReferenceDocument" name="ReferenceDocument" required minlength="2" maxlength="500" placeholder="Ví dụ: Biên bản kiểm kê số 15/BB-TV; Giấy xác nhận thu hồi số 24/XN-TV" />
                        </div>

                        <div class="mb-3">
                            <label for="reverseModalNotes" class="form-label fw-semibold">Ghi chú bổ sung (tùy chọn)</label>
                            <input type="text" class="form-control" id="reverseModalNotes" name="Notes" maxlength="1000" placeholder="Ghi chú thêm thông tin đối soát hoặc hoàn tiền nếu bạn đọc đã nộp tiền phạt..." />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy bỏ</button>
                        <button type="submit" class="btn btn-danger fw-semibold" id="btnConfirmReverse">
                            <i class="bi bi-check-circle"></i> Xác nhận lập bút toán điều chỉnh
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const loanSelect = document.getElementById('loanSelect');
            const copySelect = document.getElementById('copySelect');
            const loanDetailsBox = document.getElementById('loanDetailsBox');
            const detailReader = document.getElementById('detailReader');
            const detailCard = document.getElementById('detailCard');
            const detailBook = document.getElementById('detailBook');
            const detailLoanDate = document.getElementById('detailLoanDate');
            const detailDueDate = document.getElementById('detailDueDate');
            const photoInput = document.getElementById('incidentPhoto');
            const photoPreview = document.getElementById('photoPreview');
            const photoPreviewContainer = document.getElementById('photoPreviewContainer');

            const compensationPreviewBox = document.getElementById('compensationPreviewBox');
            const policyRateBadge = document.getElementById('policyRateBadge');
            const compensationPreviewText = document.getElementById('compensationPreviewText');

            const policyLostRate = @(Model.Policy?.LostRateOrDefault.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "1.0");
            const policyDamagedRate = @(Model.Policy?.DamagedRateOrDefault.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "1.0");

            function updateCompensationPreview() {
                if (!compensationPreviewBox || !copySelect) return;
                const selectedCopyOption = copySelect.options[copySelect.selectedIndex];
                if (!selectedCopyOption || !selectedCopyOption.value) {
                    compensationPreviewBox.classList.add('d-none');
                    return;
                }

                const rawPrice = selectedCopyOption.getAttribute('data-coverprice');
                const coverPrice = rawPrice ? parseFloat(rawPrice) : null;
                const incidentTypeInput = document.querySelector('input[name="FormModel.IncidentType"]:checked');
                const isLost = !incidentTypeInput || incidentTypeInput.value === 'Lost' || incidentTypeInput.value === '1';
                const appliedRate = isLost ? policyLostRate : policyDamagedRate;

                if (policyRateBadge) {
                    policyRateBadge.textContent = `Hệ số (${isLost ? 'Mất' : 'Hỏng nặng'}): ${appliedRate}x`;
                }

                if (coverPrice && coverPrice > 0) {
                    const estimatedAmount = Math.round((coverPrice * appliedRate) * 100) / 100;
                    compensationPreviewText.innerHTML = `
                        Giá bìa: <strong>${new Intl.NumberFormat('vi-VN').format(coverPrice)} VNĐ</strong> × Hệ số <strong>${appliedRate}x</strong> =
                        Khoản bồi thường: <strong class="text-danger fs-6">${new Intl.NumberFormat('vi-VN').format(estimatedAmount)} VNĐ</strong>
                    `;
                    compensationPreviewBox.classList.remove('d-none');
                } else {
                    compensationPreviewText.innerHTML = `
                        <span class="text-muted fst-italic">Bản sao này chưa có thông tin giá bìa hợp lệ. Sự cố vẫn sẽ được ghi nhận và loại khỏi kho, nhưng hệ thống sẽ không tự động tính khoản bồi thường.</span>
                    `;
                    compensationPreviewBox.classList.remove('d-none');
                }
            }

            // Quick select buttons from table
            document.querySelectorAll('.btn-select-loan').forEach(function (button) {
                button.addEventListener('click', function () {
                    const loanId = this.getAttribute('data-loan-id');
                    if (loanSelect) {
                        loanSelect.value = loanId;
                        loanSelect.dispatchEvent(new Event('change'));
                        loanSelect.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                });
            });

            // Photo preview handler
            if (photoInput) {
                photoInput.addEventListener('change', function () {
                    const file = this.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            photoPreview.src = e.target.result;
                            photoPreviewContainer.classList.remove('d-none');
                        };
                        reader.readAsDataURL(file);
                    } else {
                        photoPreviewContainer.classList.add('d-none');
                    }
                });
            }

            // Loan dropdown change handler
            if (loanSelect) {
                loanSelect.addEventListener('change', async function () {
                    const selectedOption = loanSelect.options[loanSelect.selectedIndex];
                    const loanId = loanSelect.value;

                    if (!loanId) {
                        loanDetailsBox.classList.add('d-none');
                        copySelect.innerHTML = '<option value="">-- Chọn bản sao --</option>';
                        updateCompensationPreview();
                        return;
                    }

                    // Update detail box
                    detailReader.textContent = selectedOption.getAttribute('data-reader') || '-';
                    detailCard.textContent = selectedOption.getAttribute('data-card') || '-';
                    detailBook.textContent = selectedOption.getAttribute('data-book') || '-';
                    detailLoanDate.textContent = selectedOption.getAttribute('data-loandate') || '-';
                    detailDueDate.textContent = selectedOption.getAttribute('data-duedate') || '-';
                    updateOverdueDisplay(selectedOption);
                    loanDetailsBox.classList.remove('d-none');

                    // Fetch copies for this loan via API
                    try {
                        const response = await fetch(`/api/book-incidents/loans/${loanId}/copies`);
                        if (response.ok) {
                            const copies = await response.json();
                            copySelect.innerHTML = '<option value="">-- Chọn bản sao --</option>';
                            copies.forEach(copy => {
                                const option = document.createElement('option');
                                option.value = copy.copyId;
                                option.setAttribute('data-coverprice', copy.coverPrice != null ? copy.coverPrice : '');
                                const priceText = copy.coverPrice != null ? `${new Intl.NumberFormat('vi-VN').format(copy.coverPrice)} VNĐ` : 'Chưa có';
                                option.textContent = `${copy.copyBarcode} (Kệ: ${copy.shelfName} - Tình trạng: ${copy.physicalCondition}) - Giá bìa: ${priceText}`;
                                copySelect.appendChild(option);
                            });
                            if (copies.length === 1) {
                                copySelect.value = copies[0].copyId;
                            }
                            updateCompensationPreview();
                        } else {
                            copySelect.innerHTML = '<option value="">-- Không tìm thấy bản sao --</option>';
                            updateCompensationPreview();
                        }
                    } catch (err) {
                        console.error('Error fetching copies:', err);
                    }
                });

                function updateOverdueDisplay(selectedOption) {
                    const detailOverdueInfo = document.getElementById('detailOverdueInfo');
                    if (!detailOverdueInfo || !selectedOption) return;
                    const dueDateRaw = selectedOption.getAttribute('data-duedate-raw');
                    if (!dueDateRaw) {
                        detailOverdueInfo.textContent = '-';
                        return;
                    }
                    const parts = dueDateRaw.split('-');
                    if (parts.length !== 3) {
                        detailOverdueInfo.textContent = '-';
                        return;
                    }
                    const dueYear = parseInt(parts[0], 10);
                    const dueMonth = parseInt(parts[1], 10) - 1;
                    const dueDay = parseInt(parts[2], 10);
                    const dueDateObj = new Date(dueYear, dueMonth, dueDay);

                    const now = new Date();
                    const todayObj = new Date(now.getFullYear(), now.getMonth(), now.getDate());

                    const diffDays = Math.floor((todayObj.getTime() - dueDateObj.getTime()) / (1000 * 60 * 60 * 24));
                    if (diffDays > 0) {
                        const estFee = diffDays * 2000;
                        detailOverdueInfo.innerHTML = `
                            <span class="badge bg-danger">Quá hạn ${diffDays} ngày</span>
                            <span class="ms-1 fw-bold text-danger">Phí trễ hạn: ${new Intl.NumberFormat('vi-VN').format(estFee)} VNĐ</span>
                            <div class="small text-muted mt-1">(Tính theo đơn giá 2.000 VNĐ / ngày trễ, hệ thống sẽ chốt và giữ nguyên khi đóng phiếu)</div>
                        `;
                    } else {
                        detailOverdueInfo.innerHTML = `
                            <span class="badge bg-success">Đúng hạn</span>
                            <span class="ms-1 text-muted">Phí trễ hạn phát sinh: 0 VNĐ</span>
                        `;
                    }
                }

                // Trigger if already selected on page load
                if (loanSelect.value) {
                    const selectedOption = loanSelect.options[loanSelect.selectedIndex];
                    detailReader.textContent = selectedOption.getAttribute('data-reader') || '-';
                    detailCard.textContent = selectedOption.getAttribute('data-card') || '-';
                    detailBook.textContent = selectedOption.getAttribute('data-book') || '-';
                    detailLoanDate.textContent = selectedOption.getAttribute('data-loandate') || '-';
                    detailDueDate.textContent = selectedOption.getAttribute('data-duedate') || '-';
                    updateOverdueDisplay(selectedOption);
                    updateCompensationPreview();
                }
            }

            if (copySelect) {
                copySelect.addEventListener('change', updateCompensationPreview);
            }

            document.querySelectorAll('input[name="FormModel.IncidentType"]').forEach(function (radio) {
                radio.addEventListener('change', updateCompensationPreview);
            });

            // Adjust Compensation Modal Handling
            const adjustModalEl = document.getElementById('adjustCompensationModal');
            let adjustModal = null;
            if (adjustModalEl && typeof bootstrap !== 'undefined') {
                adjustModal = new bootstrap.Modal(adjustModalEl);
            }

            document.querySelectorAll('.btn-adjust-compensation').forEach(function (button) {
                button.addEventListener('click', function () {
                    const incidentId = this.getAttribute('data-incident-id');
                    const summary = this.getAttribute('data-summary');
                    const coverPrice = this.getAttribute('data-cover-price');
                    const rate = this.getAttribute('data-rate');
                    const initialAmount = this.getAttribute('data-initial-amount');
                    const currentAmount = this.getAttribute('data-current-amount');
                    const currentVal = this.getAttribute('data-current-val');
                    const reason = this.getAttribute('data-reason');

                    document.getElementById('modalIncidentId').value = incidentId;
                    document.getElementById('modalIncidentSummary').textContent = summary || `#${incidentId}`;
                    document.getElementById('modalCoverPrice').textContent = coverPrice || '-';
                    document.getElementById('modalRate').textContent = rate ? `${rate}x` : '-';
                    document.getElementById('modalInitialAmount').textContent = initialAmount || '-';
                    document.getElementById('modalCurrentAmount').textContent = currentAmount || '-';
                    document.getElementById('modalNewAmount').value = currentVal || '';
                    document.getElementById('modalReason').value = '';

                    if (adjustModal) {
                        adjustModal.show();
                    } else if (typeof bootstrap !== 'undefined') {
                        new bootstrap.Modal(adjustModalEl).show();
                    }
                });
            });

            // Reverse Incident Modal Handling (Slice 5)
            const reverseModalEl = document.getElementById('reverseIncidentModal');
            let reverseModal = null;
            if (reverseModalEl && typeof bootstrap !== 'undefined') {
                reverseModal = new bootstrap.Modal(reverseModalEl);
            }

            document.querySelectorAll('.btn-reverse-incident').forEach(function (button) {
                button.addEventListener('click', function () {
                    const incidentId = this.getAttribute('data-incident-id');
                    const summary = this.getAttribute('data-summary');
                    const copyCode = this.getAttribute('data-copy-code');
                    const incidentType = this.getAttribute('data-incident-type');
                    const compensation = this.getAttribute('data-compensation');

                    document.getElementById('reverseModalIncidentId').value = incidentId;
                    document.getElementById('reverseModalSummary').textContent = summary || `#${incidentId}`;
                    document.getElementById('reverseModalCopyCode').textContent = copyCode || '-';
                    document.getElementById('reverseModalType').textContent = incidentType || '-';
                    document.getElementById('reverseModalCompensation').textContent = compensation || '0 VNĐ';
                    document.getElementById('reverseModalReason').value = '';
                    document.getElementById('reverseModalReferenceDocument').value = '';
                    document.getElementById('reverseModalNotes').value = '';

                    const radioDefault = document.getElementById('actionRestoreToLoan');
                    if (radioDefault) radioDefault.checked = true;

                    if (reverseModal) {
                        reverseModal.show();
                    } else if (typeof bootstrap !== 'undefined') {
                        new bootstrap.Modal(reverseModalEl).show();
                    }
                });
            });
        });
    </script>
}

