@model Project.Models.DirectLoanViewModel
@{
    ViewData["Title"] = "Cho mượn trực tiếp tại quầy";
}
<div class="container py-4">
    <h1 class="h3 text-primary mb-4">Cho mượn trực tiếp tại quầy</h1>
    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
    @if (TempData["DirectLoanSuccess"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    <div class="card shadow-sm border-0 mb-4"><div class="card-body">
        <form asp-action="Index" method="get">
            <label for="CardCode" class="form-label fw-semibold">1. Mã thẻ bạn đọc</label>
            <div class="input-group mb-3">
                <input id="CardCode" name="cardCode" value="@Model.CardCode" maxlength="32" class="form-control" autocomplete="off" autofocus />
                <button class="btn btn-outline-primary" type="submit">Tra cứu thẻ</button>
            </div>
            @if (Model.ReaderName != null)
            {
                <dl class="row">
                    <dt class="col-sm-4">Họ và tên</dt><dd class="col-sm-8">@Model.ReaderName</dd>
                    <dt class="col-sm-4">Loại thẻ</dt><dd class="col-sm-8">@Model.CardTypeName</dd>
                    <dt class="col-sm-4">Số sách đang mượn</dt><dd class="col-sm-8" id="currentLoans">@Model.CurrentLoans / @Model.MaxBooks</dd>
                    <dt class="col-sm-4">Còn được mượn thêm</dt><dd class="col-sm-8" id="remainingLoans">@Model.RemainingLoans</dd>
                    @if (Model.OutstandingDebt > 0)
                    {
                        <dt class="col-sm-4">Nợ chưa thanh toán</dt><dd class="col-sm-8 text-danger fw-semibold">@Project.Services.BookLoanService.FormatVnd(Model.OutstandingDebt)</dd>
                    }
                </dl>
                @if (Model.ReaderAccountId is int readerId)
                {
                    <a class="btn btn-sm btn-outline-secondary" asp-controller="ReaderLoanHistory" asp-action="Details" asp-route-id="@readerId">Xem hồ sơ và lịch sử mượn trả</a>
                }
            }
            @if (Model.ReaderError != null) { <div class="alert alert-warning">@Model.ReaderError</div> }
        </form>
        <form id="addDirectLoanCopy" data-lookup-url="@Url.Action("LookupCopy")">
            <label for="CopyCode" class="form-label fw-semibold">2. Mã vạch bản sao</label>
            <div class="input-group mb-3">
                <input id="CopyCode" name="copyCode" maxlength="50" class="form-control" autocomplete="off" />
                <button class="btn btn-outline-primary" type="submit">Thêm bản sao</button>
            </div>
            @if (Model.CopyError != null && Model.Receipt == null) { <div class="alert alert-warning">@Model.CopyError</div> }
        </form>
        <div id="selectionMessage" class="alert alert-warning" role="alert" hidden></div>
        <form asp-action="ConfirmMany" method="post" id="confirmDirectLoan"
              data-status-url="@Url.Action("Status")" data-index-url="@Url.Action("Index")"
              data-verify-only="@Model.VerifyOnly.ToString().ToLowerInvariant()" data-retrying="@Model.Retrying.ToString().ToLowerInvariant()"
              data-completed="@((Model.Receipts.Count > 0 || Model.Receipt != null).ToString().ToLowerInvariant())"
              data-remaining="@Model.RemainingLoans" data-reader-valid="@((Model.ReaderName != null && Model.ReaderError == null).ToString().ToLowerInvariant())"
              data-reader-known="@((Model.ReaderName != null).ToString().ToLowerInvariant())">
            <input type="hidden" name="CardCode" value="@Model.CardCode" />
            <input type="hidden" name="RequestId" value="@Model.RequestId" />
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead><tr><th>STT</th><th>Mã vạch</th><th>Tên đầu sách</th><th>Trạng thái</th><th>Kiểm tra</th><th>Thao tác</th></tr></thead>
                    <tbody id="selectedCopies">
                    @foreach (var copy in Model.SelectedCopies)
                    {
                        <tr data-code="@copy.CopyCode" data-title="@copy.BookTitle" data-status="@copy.Status" data-row-id="@copy.RowId" data-error="@copy.Error" data-hold-id="@copy.HoldId">
                            <td></td><td>@copy.CopyCode</td><td>@copy.BookTitle</td><td>@copy.Status</td>
                            <td class="@(copy.IsValid ? "text-success" : "text-danger")">@(copy.Error ?? "Hợp lệ")
                                @if (copy.HoldId.HasValue) { <div class="small">Đơn đặt trước #@copy.HoldId</div> }
                            </td><td></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <p aria-live="polite">Đang chọn: <strong id="selectedCount">0</strong>. Còn được chọn: <strong id="remainingSelection">@Model.RemainingLoans</strong>.</p>
            <p aria-live="polite">Hợp lệ: <strong id="validCount">0</strong>. Có lỗi: <strong id="errorCount">0</strong>. Đang kiểm tra: <strong id="pendingCount">0</strong>.</p>
            <div id="rowWarning" class="alert alert-warning" role="status" hidden>Vui lòng sửa hoặc xóa hết dòng lỗi và chờ kiểm tra xong trước khi xác nhận.</div>
            <div id="limitWarning" class="alert alert-warning" role="alert" hidden></div>
            @if (Model.CanOverride)
            {
                <div class="alert alert-warning py-2" role="note">Quyền bỏ qua chặn chỉ áp dụng cho lượt này. Lý do bắt buộc nhập khi bạn đọc vi phạm chính sách.</div>
                <div class="mb-3">
                    <label for="BypassReason" class="form-label fw-semibold">Lý do bỏ qua chặn (thủ thư/quản lý)</label>
                    <textarea id="BypassReason" name="BypassReason" class="form-control" maxlength="160" rows="2" placeholder="Nhập lý do nếu cần bỏ qua chính sách"></textarea>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" id="ConfirmBypass" name="ConfirmBypass" value="true" />
                    <label class="form-check-label" for="ConfirmBypass">Tôi xác nhận bỏ qua chính sách cho lượt mượn này</label>
                </div>
            }
            <button type="submit" class="btn btn-primary" disabled>Xác nhận mượn</button>
            <button type="button" id="verifyDirectLoan" class="btn btn-outline-primary" hidden>Kiểm tra kết quả</button>
            <p class="text-muted small mt-2 mb-0">Nhập mã vạch rồi nhấn Enter để thêm sách. Xác nhận một lần cho toàn bộ danh sách.</p>
        </form>
    </div></div>
    @if (Model.Receipts.Count > 0)
    {
        <h2 class="h5">Đã mượn thành công @Model.Receipts.Count bản sao</h2>
    }
    @foreach (var receipt in Model.Receipts.Concat(Model.Receipt == null ? Enumerable.Empty<Project.Models.BookLoan>() : new[] { Model.Receipt }))
    {
        <div class="card shadow-sm border-0"><div class="card-body">
            <h2 class="h5">Phiếu mượn #@receipt.Id</h2>
            <dl class="row mb-0">
                <dt class="col-sm-4">Bạn đọc</dt><dd class="col-sm-8">@receipt.ReaderAccount?.FullName</dd>
                <dt class="col-sm-4">Mã vạch</dt><dd class="col-sm-8">@receipt.BookCopy?.CopyCode</dd>
                @if (receipt.SourceBookHoldId.HasValue)
                {
                    <dt class="col-sm-4">Đơn đặt trước</dt><dd class="col-sm-8">#@receipt.SourceBookHoldId</dd>
                }
                <dt class="col-sm-4">Ngày mượn</dt><dd class="col-sm-8">@receipt.LoanDate.ToString("dd/MM/yyyy")</dd>
                <dt class="col-sm-4">Hạn trả</dt><dd class="col-sm-8">@receipt.DueDate.ToString("dd/MM/yyyy")</dd>
                <dt class="col-sm-4">Trạng thái</dt><dd class="col-sm-8">Đang mượn</dd>
            </dl>
        </div></div>
    }
</div>
@section Scripts {
    <script src="~/js/direct-loan-state.js" asp-append-version="true"></script>
    <script src="~/js/direct-loan.js" asp-append-version="true"></script>
}
