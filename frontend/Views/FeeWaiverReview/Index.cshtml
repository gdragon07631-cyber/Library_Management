@model FeeWaiverManagerIndexViewModel
@{
    ViewData["Title"] = "Duyệt miễn giảm";
}
<div class="container-fluid py-4 px-4">
    <div class="mb-4">
        <h1 class="h3 text-primary fw-bold">Đề nghị miễn giảm đang chờ</h1>
        <p class="text-muted mb-0">Xem phí gốc, số dư khoản thu và lý do trước khi quyết định.</p>
    </div>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Đề nghị</th><th>Bạn đọc / phiếu</th><th>Phí gốc</th><th>Số dư lúc đề nghị</th><th>Đề nghị miễn</th><th>Lý do</th><th>Người gửi</th><th></th></tr></thead>
                <tbody>
                @if (Model.PendingRequests.Count == 0) { <tr><td colspan="8" class="text-center text-muted py-4">Không có đề nghị đang chờ duyệt.</td></tr> }
                @foreach (var request in Model.PendingRequests)
                {
                    <tr>
                        <td>#@request.Id<div class="small text-muted">@request.RequestedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></td>
                        <td>@request.ReaderName<div class="small text-muted">@request.ReaderCode · Khoản #@request.ReaderFeeId · @(request.LoanId is null ? "" : $"Phiếu #{request.LoanId}")</div></td>
                        <td>@request.OriginalFeeAmount.ToString("N0") đ</td>
                        <td>@request.FeeBalanceAtRequest.ToString("N0") đ trên khoản thu<div class="small text-muted">Dư nợ bạn đọc: @request.ReaderBalanceAtRequest.ToString("N0") đ</div></td>
                        <td><strong>@request.RequestedAmount.ToString("N0") đ</strong></td>
                        <td>@request.Reason</td><td>@request.RequestedBy</td>
                        <td><a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@request.Id">Xem và xử lý</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
