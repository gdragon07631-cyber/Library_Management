@inject Project.Services.IAuditLogService AuditLogAccess
@using Project.Models
@{
    ViewData["Title"] = "Tổng quan";
    var role = (await AuditLogAccess.GetSignedInStaffAsync(Context.Request))?.Role;
    string[] library = [AccountRoles.SystemAdmin, AccountRoles.LibraryManager];
    string[] adminOnly = [AccountRoles.SystemAdmin];
    string[] everyone = [AccountRoles.SystemAdmin, AccountRoles.LibraryManager, AccountRoles.Librarian];
    var modules = new[]
    {
        new { Group = "Bộ sưu tập", Name = "Sách", Description = "Tra cứu danh mục và biên mục sách mới.", Controller = "Book", Action = "Index", Roles = library },
        new { Group = "Bộ sưu tập", Name = "Tác giả", Description = "Quản lý thông tin tác giả.", Controller = "Author", Action = "Index", Roles = library },
        new { Group = "Bộ sưu tập", Name = "Thể loại", Description = "Sắp xếp và quản lý thể loại sách.", Controller = "Category", Action = "Index", Roles = library },
        new { Group = "Vận hành", Name = "Kho sách", Description = "Theo dõi các kho trong thư viện.", Controller = "Warehouse", Action = "Index", Roles = library },
        new { Group = "Vận hành", Name = "Kệ sách", Description = "Quản lý vị trí và kệ lưu trữ.", Controller = "Shelf", Action = "Index", Roles = library },
        new { Group = "Vận hành", Name = "Mượn trả", Description = "Lập và theo dõi phiếu mượn.", Controller = "Loan", Action = "Index", Roles = library },
        new { Group = "Vận hành", Name = "Lịch làm việc", Description = "Cập nhật lịch tuần và ngày nghỉ.", Controller = "WorkingSchedule", Action = "Index", Roles = library },
        new { Group = "Bạn đọc", Name = "Đăng ký bạn đọc", Description = "Tạo hồ sơ bạn đọc mới.", Controller = "ReaderRegistration", Action = "Register", Roles = everyone },
        new { Group = "Hệ thống", Name = "Chính sách mượn", Description = "Thiết lập số ngày mượn và ngưỡng khoá thẻ.", Controller = "LoanPolicy", Action = "Index", Roles = library },
        new { Group = "Hệ thống", Name = "Hệ số bồi thường", Description = "Cấu hình tỷ lệ bồi thường sách mất/hỏng.", Controller = "CompensationPolicy", Action = "Index", Roles = library },
        new { Group = "Hệ thống", Name = "Tài khoản bạn đọc", Description = "Tra cứu, sửa, khoá và mở khoá thẻ bạn đọc.", Controller = "ReaderAccount", Action = "Index", Roles = library },
        new { Group = "Hệ thống", Name = "Tài khoản nhân sự", Description = "Tạo tài khoản, gán vai trò, khoá tài khoản.", Controller = "StaffAccount", Action = "Index", Roles = adminOnly },
        new { Group = "Hệ thống", Name = "Ma trận phân quyền", Description = "Xem, đối chiếu và cấu hình phân quyền theo vai trò.", Controller = "PermissionMatrix", Action = "Index", Roles = adminOnly },
        new { Group = "Hệ thống", Name = "Nhật ký hoạt động", Description = "Tra ai đã thao tác gì, lúc nào, từ IP nào.", Controller = "AuditLog", Action = "Index", Roles = library },
    }
    .Where(module => role is not null && module.Roles.Contains(role))
    .Select((module, index) => new { module.Group, module.Name, module.Description, module.Controller, module.Action, Icon = (index + 1).ToString("00") })
    .ToArray();
}

<div class="dashboard">
    <section class="dashboard-hero">
        <div>
            <div class="eyebrow">THƯ VIỆN · BẢNG ĐIỀU KHIỂN</div>
            <h1>Chào mừng trở lại</h1>
            <p>Chọn một chức năng để bắt đầu công việc hôm nay.</p>
        </div>
        <a class="hero-action" asp-controller="Book" asp-action="Create"><span>＋</span> Biên mục sách mới</a>
    </section>

    <div class="dashboard-heading">
        <div><h2>Chức năng</h2><p>Lối tắt đến các khu vực quản lý thư viện</p></div>
        <span class="module-count">@modules.Length.ToString("00") khu vực</span>
    </div>

    @foreach (var group in modules.GroupBy(x => x.Group))
    {
        <section class="module-section">
            <h3>@group.Key</h3>
            <div class="module-grid">
                @foreach (var module in group)
                {
                    <a class="module-card" asp-controller="@module.Controller" asp-action="@module.Action">
                        <span class="module-icon">@module.Icon</span>
                        <span class="module-arrow" aria-hidden="true">↗</span>
                        <span class="module-name">@module.Name</span>
                        <span class="module-description">@module.Description</span>
                    </a>
                }
            </div>
        </section>
    }
</div>
