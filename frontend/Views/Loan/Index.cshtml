@model Project.Models.LoanIndexViewModel
@{
    ViewData["Title"] = "Phiếu mượn";
}
<div class="container py-4">
    <a asp-controller="DirectLoan" asp-action="Index" class="btn btn-primary mb-3">Cho mượn trực tiếp tại quầy</a>
    <div class="mb-4"><h1 class="h3 mb-1 text-primary fw-bold">Phiếu mượn</h1><p class="text-muted mb-0">Hạn trả được tự động chuyển sang ngày thư viện mở cửa kế tiếp.</p></div>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["ErrorMessage"] is string error) {
        <div class="alert alert-danger d-flex justify-content-between align-items-center mb-4">
            <div>@error</div>
            @if (Model.CanOverride && TempData["BlockedReaderId"] != null) {
                <button type="button" class="btn btn-warning btn-sm fw-semibold ms-3 text-nowrap" data-bs-toggle="modal" data-bs-target="#overrideModal">
                    Bỏ qua
                </button>
            }
        </div>
    }
    <div class="card shadow-sm border-0 mb-4"><div class="card-header bg-white"><h2 class="h5 mb-0">Tạo phiếu mượn</h2></div><div class="card-body">
        <form asp-action="Create" method="post" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-4"><label class="form-label">Sách</label><select class="form-select" name="BookId" id="bookSelect" required><option value="">-- Chọn sách --</option>@foreach (var book in Model.Books) { <option value="@book.Id">@book.Title</option> }</select></div>
            <div class="col-md-4">
                <label class="form-label">Bạn đọc</label>
                <select class="form-select" name="ReaderAccountId" id="readerSelect" required>
                    <option value="">-- Chọn bạn đọc --</option>
                    @foreach (var reader in Model.Readers) {
                        var currentLoans = Model.ReaderLoanCounts.TryGetValue(reader.Id, out var count) ? count : 0;
                        var limit = reader.LibraryCard?.LibraryCardType?.MaxBooks ?? Project.Models.LibraryCardType.DefaultMaxBooks;
                        var isExpired = reader.LibraryCard != null && reader.LibraryCard.ExpiresOn < DateOnly.FromDateTime(DateTime.Today);
                        var isLocked = reader.IsLocked || (reader.LibraryCard != null && reader.LibraryCard.IsLocked);
                        var hasOverdue = Model.ReaderHasOverdue.Contains(reader.Id);
                        var lateCount = Model.ReaderLateReturnCounts.TryGetValue(reader.Id, out var lc) ? lc : 0;
                        var lateRate = Model.ReaderLateReturnRates.TryGetValue(reader.Id, out var lr) ? lr : 0m;
                        var isFrequentLate = Model.ReaderFrequentLateIds.Contains(reader.Id);
                        var totalDebt = reader.TotalDebt;
                        var debtText = Project.Services.BookLoanService.FormatVnd(totalDebt);
                        <option value="@reader.Id"
                                data-current-loans="@currentLoans"
                                data-max-loans="@limit"
                                data-is-expired="@(isExpired ? "true" : "false")"
                                data-is-locked="@(isLocked ? "true" : "false")"
                                data-has-overdue="@(hasOverdue ? "true" : "false")"
                                data-late-count="@lateCount"
                                data-late-rate="@lateRate.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)"
                                data-is-frequent-late="@(isFrequentLate ? "true" : "false")"
                                data-debt="@totalDebt"
                                data-debt-text="@debtText">
                            @reader.FullName (@reader.StudentOrStaffCode) - Đang mượn: @currentLoans/@limit sách@(isFrequentLate ? $" [⚠ Thường xuyên trả trễ: {lateCount} lần]" : "")
                        </option>
                    }
                </select>
                <div id="readerLoanLimitInfo" class="form-text mt-1 text-muted" style="min-height: 20px;"></div>
                <div id="readerFrequentLateAlert" class="alert alert-warning border-warning py-2 px-3 mt-2 mb-1 small" role="alert" hidden></div>
                <a id="readerLoanHistoryLink" class="small" href="#" hidden>Xem hồ sơ và lịch sử mượn</a>
            </div>
            <div class="col-md-2"><label class="form-label">Ngày mượn</label><input class="form-control" type="date" name="LoanDate" id="loanDateInput" value="@Model.NewLoan.LoanDate?.ToString("yyyy-MM-dd")" required /></div>
            <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Tạo phiếu</button></div>
        </form>
    </div></div>
    <div class="card shadow-sm border-0"><div class="card-header bg-white"><h2 class="h5 mb-0">Danh sách phiếu mượn</h2></div><div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Sách</th><th>Bạn đọc</th><th>Ngày mượn</th><th>Hạn trả</th><th>Thao tác</th></tr></thead><tbody>
        @if (Model.Loans.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có phiếu mượn.</td></tr> }
        @foreach (var loan in Model.Loans) {
            var renewalLimit = loan.ReaderAccount?.LibraryCard?.LibraryCardType?.MaxRenewals ?? 0;
            var readerIsFrequentLate = Model.ReaderFrequentLateIds.Contains(loan.ReaderAccountId);
            var readerLateCount = Model.ReaderLateReturnCounts.TryGetValue(loan.ReaderAccountId, out var rlc) ? rlc : 0;
            <tr>
                <td>@loan.Book?.Title</td>
                <td>
                    <a asp-controller="ReaderLoanHistory" asp-action="Details" asp-route-id="@loan.ReaderAccountId" class="text-decoration-none fw-semibold">@loan.ReaderAccount?.FullName</a>
                    @if (readerIsFrequentLate)
                    {
                        <span class="badge bg-warning text-dark ms-1" title="Bạn đọc thường xuyên trả trễ (@readerLateCount lần)">⚠ Thường xuyên trả trễ</span>
                    }
                </td>
                <td>@loan.LoanDate.ToString("dd/MM/yyyy")</td>
                <td class="fw-semibold">@loan.DueDate.ToString("dd/MM/yyyy") @if (loan.DueDate != loan.OriginalDueDate) { <span class="badge bg-info text-dark">Đã điều chỉnh</span> }<div class="small text-muted">Số lần gia hạn: @loan.RenewalCount / @renewalLimit</div></td>
                <td>@if (!loan.IsReturned && loan.DueDate >= DateOnly.FromDateTime(DateTime.Today)) { <form asp-action="Renew" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@loan.Id" /><button class="btn btn-sm btn-outline-primary" type="submit">Gia hạn</button></form> }</td>
            </tr>
        }
    </tbody></table></div></div>


    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0 text-danger fw-semibold">Lịch sử chặn cho mượn</h2>
            <span class="badge bg-secondary">@Model.BlockedLoanLogs.Count lần chặn</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Thời điểm</th>
                        <th>Bạn đọc</th>
                        <th>Người thực hiện</th>
                        <th>Lý do bị chặn</th>
                        <th>Lý do bỏ qua</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.BlockedLoanLogs.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">Chưa có lần chặn cho mượn nào được ghi nhận.</td></tr>
                    }
                    @foreach (var log in Model.BlockedLoanLogs)
                    {
                        <tr>
                            <td class="text-nowrap fw-semibold">@DateTime.SpecifyKind(log.OccurredAtUtc, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                            <td>
                                <div><span class="fw-semibold">@log.ReaderName</span></div>
                                @if (!string.IsNullOrEmpty(log.ReaderEmail))
                                {
                                    <div class="small text-muted">@log.ReaderEmail</div>
                                }
                            </td>
                            <td><span class="badge bg-light text-dark border">@log.Operator</span></td>
                            <td><span class="badge bg-danger-subtle text-danger-emphasis text-wrap text-start">@log.Reason</span></td>
                            <td>
                                @if (!string.IsNullOrEmpty(log.BypassReason))
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis text-wrap text-start">@log.BypassReason</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                @if (log.Status == "Đã bỏ qua")
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">Đã bỏ qua</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle">Bị chặn</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.CanOverride)
    {
        <div class="modal fade" id="overrideModal" tabindex="-1" aria-labelledby="overrideModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <form asp-action="Override" method="post" id="overrideForm">
                        @Html.AntiForgeryToken()
                        <div class="modal-header">
                            <h5 class="modal-title text-warning-emphasis fw-bold" id="overrideModalLabel">Bỏ qua một lần chặn cho mượn</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                        </div>
                        <div class="modal-body">
                            <div class="alert alert-warning mb-3">
                                <div class="fw-semibold mb-1">Lý do chặn ban đầu:</div>
                                <div id="modalBlockedReason">@(TempData["BlockedErrorMessage"] ?? "Bạn đọc vi phạm chính sách mượn sách.")</div>
                            </div>

                            <input type="hidden" name="ReaderAccountId" id="modalReaderId" value="@(TempData["BlockedReaderId"] ?? "")" />
                            <input type="hidden" name="BookId" id="modalBookId" value="@(TempData["BlockedBookId"] ?? "")" />
                            @if (TempData["BlockedBookIds"] != null)
                            {
                                var bIds = TempData["BlockedBookIds"]?.ToString()?.Split(',', StringSplitOptions.RemoveEmptyEntries) ?? [];
                                foreach (var bId in bIds)
                                {
                                    <input type="hidden" name="BookIds" value="@bId" />
                                }
                            }
                            <input type="hidden" name="LoanDate" id="modalLoanDate" value="@(TempData["BlockedLoanDate"] ?? Model.NewLoan.LoanDate?.ToString("yyyy-MM-dd"))" />

                            <div class="mb-3">
                                <label for="bypassReasonInput" class="form-label fw-semibold">Lý do bỏ qua <span class="text-danger">*</span></label>
                                <textarea class="form-control" id="bypassReasonInput" name="BypassReason" rows="3" placeholder="Nhập lý do cho phép mượn sách..."></textarea>
                                <div id="bypassReasonValidation" class="text-danger small mt-1 d-none">
                                    Vui lòng nhập lý do bỏ qua.
                                </div>
                            </div>
                            <div class="text-muted small">
                                <em>Lưu ý: Quyết định bỏ qua chỉ áp dụng cho lần mượn này và sẽ được ghi nhận đầy đủ vào nhật ký kiểm toán.</em>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                            <button type="submit" class="btn btn-warning fw-semibold" id="confirmOverrideBtn">Xác nhận bỏ qua</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<script>
    (function () {
        var readerSelect = document.getElementById('readerSelect');
        var info = document.getElementById('readerLoanLimitInfo');
        var frequentLateAlert = document.getElementById('readerFrequentLateAlert');
        var historyLink = document.getElementById('readerLoanHistoryLink');
        var canOverride = @(Model.CanOverride ? "true" : "false");
        if (!readerSelect || !info) return;

        function updateLoanInfo() {
            var selected = readerSelect.selectedOptions[0];
            if (historyLink) {
                historyLink.hidden = !selected || !selected.value;
                if (selected && selected.value) historyLink.href = '/ReaderLoanHistory/Details/' + encodeURIComponent(selected.value);
            }
            if (selected && selected.value) {
                var current = parseInt(selected.getAttribute('data-current-loans') || '0', 10);
                var max = parseInt(selected.getAttribute('data-max-loans') || '5', 10);
                var isExpired = selected.getAttribute('data-is-expired') === 'true';
                var isLocked = selected.getAttribute('data-is-locked') === 'true';
                var hasOverdue = selected.getAttribute('data-has-overdue') === 'true';
                var lateCount = parseInt(selected.getAttribute('data-late-count') || '0', 10);
                var lateRate = selected.getAttribute('data-late-rate') || '0';
                var isFrequentLate = selected.getAttribute('data-is-frequent-late') === 'true';
                var debt = parseFloat(selected.getAttribute('data-debt') || '0');
                var debtText = selected.getAttribute('data-debt-text') || '';
                var isReached = current >= max;

                var isBlocked = isReached || isLocked || isExpired || hasOverdue || (debt > 0);
                var reasons = [];

                var html = '<span class="badge ' + (isReached ? 'bg-danger' : 'bg-info text-dark') + '">' +
                    'Đang mượn: ' + current + '/' + max + ' sách' +
                    (isReached ? ' (Đã đạt hạn mức)' : '') +
                    '</span>';

                if (isFrequentLate) {
                    html += ' <span class="badge bg-warning text-dark">⚠ Thường xuyên trả trễ (' + lateCount + ' lần · ' + lateRate + '%)</span>';
                }

                if (frequentLateAlert) {
                    if (isFrequentLate) {
                        frequentLateAlert.hidden = false;
                        frequentLateAlert.innerHTML = '<strong>⚠ Cảnh báo: Bạn đọc thường xuyên trả trễ</strong> (' +
                            lateCount + ' lần trả trễ, tỷ lệ trễ ' + lateRate + '%). Hãy bấm <em>Xem hồ sơ và lịch sử mượn</em> để cân nhắc trước khi quyết định cho mượn tiếp.';
                    } else {
                        frequentLateAlert.hidden = true;
                        frequentLateAlert.innerHTML = '';
                    }
                }

                if (isReached) {
                    reasons.push('Bạn đang mượn ' + current + '/' + max + ' sách, không thể mượn thêm.');
                }
                if (isLocked) {
                    html += ' <span class="badge bg-danger">Thẻ đang bị khoá</span>';
                    reasons.push('Thẻ bạn đọc đang bị khoá.');
                }
                if (isExpired) {
                    html += ' <span class="badge bg-danger">Thẻ đã hết hạn</span>';
                    reasons.push('Thẻ bạn đọc đã hết hạn.');
                }
                if (hasOverdue) {
                    html += ' <span class="badge bg-danger">Có phiếu quá hạn chưa trả</span>';
                    reasons.push('Bạn đọc đang có phiếu mượn quá hạn chưa trả.');
                }
                if (debt > 0) {
                    html += ' <span class="badge bg-danger">Còn nợ: ' + debtText + '</span>';
                    reasons.push('Bạn còn nợ ' + debtText + ', không thể mượn sách.');
                }

                if (isBlocked && canOverride) {
                    html += ' <button type="button" class="btn btn-warning btn-sm py-0 px-2 ms-2 fw-semibold" id="btnQuickBypass">Bỏ qua</button>';
                }

                info.innerHTML = html;

                var quickBtn = document.getElementById('btnQuickBypass');
                if (quickBtn) {
                    quickBtn.addEventListener('click', function () {
                        var modalReaderId = document.getElementById('modalReaderId');
                        var modalBookId = document.getElementById('modalBookId');
                        var modalLoanDate = document.getElementById('modalLoanDate');
                        var modalReason = document.getElementById('modalBlockedReason');
                        var bookSelect = document.getElementById('bookSelect');
                        var loanDateInput = document.getElementById('loanDateInput');

                        if (modalReaderId) modalReaderId.value = selected.value;
                        if (modalBookId && bookSelect) modalBookId.value = bookSelect.value;
                        if (modalLoanDate && loanDateInput) modalLoanDate.value = loanDateInput.value;
                        if (modalReason && reasons.length > 0) modalReason.textContent = reasons.join(' ');

                        var modalEl = document.getElementById('overrideModal');
                        if (modalEl && window.bootstrap) {
                            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                            modal.show();
                        }
                    });
                }
            } else {
                info.textContent = '';
                if (frequentLateAlert) {
                    frequentLateAlert.hidden = true;
                    frequentLateAlert.innerHTML = '';
                }
            }
        }

        readerSelect.addEventListener('change', updateLoanInfo);
        updateLoanInfo();

        var overrideForm = document.getElementById('overrideForm');
        if (overrideForm) {
            overrideForm.addEventListener('submit', function (e) {
                var reasonInput = document.getElementById('bypassReasonInput');
                var val = reasonInput ? reasonInput.value.trim() : '';
                var feedback = document.getElementById('bypassReasonValidation');

                if (!val) {
                    e.preventDefault();
                    if (reasonInput) reasonInput.classList.add('is-invalid');
                    if (feedback) feedback.classList.remove('d-none');
                    return false;
                }
            });

            var reasonInput = document.getElementById('bypassReasonInput');
            if (reasonInput) {
                reasonInput.addEventListener('input', function () {
                    var feedback = document.getElementById('bypassReasonValidation');
                    if (reasonInput.value.trim()) {
                        reasonInput.classList.remove('is-invalid');
                        if (feedback) feedback.classList.add('d-none');
                    }
                });
            }
        }
    })();
</script>
</div>
