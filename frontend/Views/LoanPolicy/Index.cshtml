@model Project.Models.LoanPolicyViewModel
@{
    ViewData["Title"] = "Chính sách mượn";
}
<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 mb-1 text-primary fw-bold">Chính sách mượn</h1>
        <p class="text-muted mb-0">Thiết lập chính sách mượn chung của thư viện.</p>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">@success<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="card shadow-sm border-0" style="max-width: 36rem">
        <div class="card-body">
            <form asp-action="Index" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="LoanDays" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <input asp-for="LoanDays" class="form-control" type="number" min="1" max="365" />
                        <span class="input-group-text">ngày</span>
                    </div>
                    <span asp-validation-for="LoanDays" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="DailyOverdueFee" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <input asp-for="DailyOverdueFee" class="form-control" type="number" min="0" max="1000000000" step="0.01" />
                        <span class="input-group-text">VNĐ/ngày</span>
                    </div>
                    <span asp-validation-for="DailyOverdueFee" class="text-danger"></span>
                    <div class="form-text">Phí dự kiến được làm tròn đến 1.000 VNĐ gần nhất; đúng điểm giữa làm tròn lên.</div>
                </div>
                <div class="mb-3">
                    <label asp-for="DebtLockThreshold" class="form-label fw-semibold"></label>
                    <div class="input-group">
                        <input asp-for="DebtLockThreshold" class="form-control" type="number" min="0" step="1000" />
                        <span class="input-group-text">VND</span>
                    </div>
                    <span asp-validation-for="DebtLockThreshold" class="text-danger"></span>
                </div>
                @if (Model.UpdatedAtUtc is DateTime updatedAt)
                {
                    <p class="text-muted small">Cập nhật lần cuối: @DateTime.SpecifyKind(updatedAt, DateTimeKind.Utc).ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
                }
                <button type="submit" class="btn btn-primary">Lưu chính sách</button>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0 mt-4" id="de-xuat-khoa-the">
        <div class="card-header bg-white">
            <h2 class="h5 mb-1">Đề xuất khoá thẻ</h2>
            <p class="text-muted small mb-0">Danh sách bạn đọc đủ điều kiện đề xuất khoá theo quá hạn trên 30 ngày hoặc nợ phí vượt ngưỡng.</p>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Mã bạn đọc</th>
                        <th>Họ tên</th>
                        <th>Mã thẻ</th>
                        <th>Số ngày quá hạn</th>
                        <th>Số tiền nợ</th>
                        <th>Lý do đề xuất</th>
                        <th>Trạng thái thẻ</th>
                        <th class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.LockProposals.Count == 0)
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">Không có bạn đọc nào đang đủ điều kiện đề xuất khoá thẻ.</td></tr>
                }
                @foreach (var proposal in Model.LockProposals)
                {
                    <tr>
                        <td>@proposal.ReaderAccountId</td>
                        <td>@proposal.ReaderName</td>
                        <td>@(proposal.CardCode ?? "-")</td>
                        <td>@proposal.MaxOverdueDays</td>
                        <td>@proposal.OutstandingDebt.ToString("#,##0")</td>
                        <td>
                            @foreach (var reason in proposal.Reasons)
                            {
                                <span class="badge bg-warning-subtle text-warning-emphasis me-1">@reason</span>
                            }
                        </td>
                        <td>@proposal.Status</td>
                        <td class="text-end">
                            <a asp-controller="ReaderAccount" asp-action="Details" asp-route-id="@proposal.ReaderAccountId" asp-route-action="lock" asp-route-reason="@string.Join("; ", proposal.Reasons)" class="btn btn-sm btn-outline-danger">Xem &amp; Khoá thẻ</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm border-0 mt-4">
        <div class="card-header bg-white">
            <h2 class="h5 mb-1">Số ngày mượn theo loại thẻ</h2>
            <p class="text-muted small mb-0">Thiết lập số ngày áp dụng khi thủ thư chuyển đơn đặt giữ thành phiếu mượn. Loại thẻ chưa cấu hình sẽ không thể xác nhận đơn.</p>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light"><tr><th>Loại thẻ</th><th style="width: 380px">Số ngày mượn</th></tr></thead>
                <tbody>
                @if (Model.CardTypePolicies.Count == 0)
                {
                    <tr><td colspan="2" class="text-center text-muted py-4">Chưa có loại thẻ thư viện.</td></tr>
                }
                @foreach (var cardType in Model.CardTypePolicies)
                {
                    <tr>
                        <td>@cardType.Name</td>
                        <td>
                            <form asp-action="UpdateCardTypeLoanDays" method="post" class="d-flex gap-2 align-items-center">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="LibraryCardTypeId" value="@cardType.LibraryCardTypeId" />
                                <input type="number" name="LoanDays" class="form-control" min="1" max="365" required value="@cardType.LoanDays" aria-label="Số ngày mượn cho @cardType.Name" />
                                <span class="text-muted">ngày</span>
                                <button type="submit" class="btn btn-sm btn-outline-primary text-nowrap">Lưu</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
