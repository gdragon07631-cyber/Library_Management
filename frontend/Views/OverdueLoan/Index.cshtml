@model Project.Models.OverdueLoanViewModel
@inject Project.Services.IAuditLogService AuditService
@{
    ViewData["Title"] = "Phiếu mượn quá hạn";
    var exportStaff = await AuditService.GetSignedInStaffAsync(Context.Request, Context.RequestAborted);
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-1">Phiếu mượn quá hạn</h1>
        <p class="text-muted mb-0">Ưu tiên liên hệ các trường hợp trễ lâu nhất.</p>
    </div>
</div>

@if (exportStaff?.Role == Project.Models.AccountRoles.LibraryManager)
{
    <form id="overdue-export" action="@Url.Content("~/api/overdue-readers/export")" method="post" class="mb-3">
        @Html.AntiForgeryToken()
        <div class="mb-2">
            <label for="exportLibraryCardTypeId" class="form-label">Loại thẻ</label>
            <select id="exportLibraryCardTypeId" name="libraryCardTypeId" class="form-select"
                    data-source="@Url.Content("~/api/overdue-readers/card-types")" disabled>
                <option value="">Tất cả</option>
            </select>
            <div id="export-card-types-status" role="status" aria-live="polite">Đang tải loại thẻ…</div>
            <button id="reload-export-card-types" type="button" class="btn btn-outline-secondary btn-sm mt-1" hidden>Thử tải lại loại thẻ</button>
        </div>
        <div class="mb-2">
            <label for="minimumOverdueDays" class="form-label">Số ngày trễ tối thiểu</label>
            <input id="minimumOverdueDays" name="minimumOverdueDays" type="text" inputmode="numeric"
                   class="form-control" aria-describedby="minimum-overdue-help" />
            <div id="minimum-overdue-help" class="form-text">Bỏ trống: không lọc ngày trễ. Nhập 0: áp dụng ngưỡng 0, gồm cả bạn đọc chỉ nợ phí. Nhập số nguyên từ 0 đến 2147483647; ngưỡng lớn hơn 0 loại bạn đọc chỉ nợ phí.</div>
        </div>
        <button type="submit" class="btn btn-success" disabled>Xuất Excel</button>
        <span class="text-muted ms-2">Xuất bạn đọc thỏa đồng thời loại thẻ và ngưỡng ngày trễ trên; không áp dụng bộ lọc danh sách bên dưới.</span>
        <div id="overdue-export-message" role="status" aria-live="polite" class="mt-2"></div>
    </form>
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<form method="get" class="card shadow-sm border-0 mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-end">
        <div>
            <label for="overdueRange" class="form-label mb-1">Khoảng số ngày trễ</label>
            <select id="overdueRange" name="overdueRange" class="form-select">
                <option value="@Project.Models.OverdueLoanRanges.All" selected="@(Model.Range == Project.Models.OverdueLoanRange.All ? "selected" : null)">Tất cả</option>
                <option value="@Project.Models.OverdueLoanRanges.OneToSevenDays" selected="@(Model.Range == Project.Models.OverdueLoanRange.OneToSevenDays ? "selected" : null)">Trễ từ 1 - 7 ngày</option>
                <option value="@Project.Models.OverdueLoanRanges.MoreThanSevenDays" selected="@(Model.Range == Project.Models.OverdueLoanRange.MoreThanSevenDays ? "selected" : null)">Trễ trên 7 ngày</option>
                <option value="@Project.Models.OverdueLoanRanges.MoreThanThirtyDays" selected="@(Model.Range == Project.Models.OverdueLoanRange.MoreThanThirtyDays ? "selected" : null)">Trễ trên 30 ngày</option>
            </select>
        </div>
        <button type="submit" class="btn btn-primary">Lọc</button>
    </div>
</form>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Số ngày trễ</th><th>Bạn đọc</th><th>Số điện thoại</th><th>Mã thẻ</th><th>Tên sách</th><th>Mã phiếu</th><th>Hạn trả</th><th>Lần liên hệ gần nhất</th><th></th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-5">@(Model.Range == Project.Models.OverdueLoanRange.All ? "Không có phiếu mượn quá hạn." : "Không tìm thấy phiếu mượn nào quá hạn trong khoảng đã chọn.")</td></tr>
                }
                else
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td><span class="badge bg-danger">@item.DaysOverdue ngày</span></td><td class="fw-semibold">@item.ReaderName</td><td class="text-nowrap">@item.PhoneNumber</td><td>@(item.CardCode ?? "—")</td><td>@item.BookTitle</td><td>#@item.LoanId</td><td class="text-nowrap">@item.DueDate.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (item.LatestContact is not null)
                                {
                                    <div class="small fw-semibold">@Project.Services.HoldPickupExpirySchedule.GetVietnamLocalTime(item.LatestContact.CreatedAtUtc).ToString("dd/MM/yyyy HH:mm")</div>
                                    <div class="small text-muted text-truncate" style="max-width: 180px" title="@item.LatestContact.Note">@item.LatestContact.Note</div>
                                }
                                else { <span class="text-muted small">Chưa liên hệ</span> }
                            </td>
                            <td class="text-nowrap"><button type="button" class="btn btn-sm btn-primary contact-button" data-bs-toggle="modal" data-bs-target="#contactModal" data-loan-id="@item.LoanId">Ghi nhận liên hệ</button><a asp-action="History" asp-route-id="@item.LoanId" class="btn btn-sm btn-outline-secondary ms-1">Lịch sử</a></td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="contactModal" tabindex="-1" aria-labelledby="contactModalLabel" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
        <form asp-action="AddContact" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="LoanId" id="contactLoanId" />
            <input type="hidden" name="overdueRange" value="@Project.Models.OverdueLoanRanges.ToQueryValue(Model.Range)" />
            <div class="modal-header"><h5 class="modal-title" id="contactModalLabel">Ghi nhận liên hệ</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
            <div class="modal-body"><label for="contactNote" class="form-label">Nội dung ghi chú</label><textarea id="contactNote" name="Note" class="form-control" rows="4" maxlength="1000" required placeholder="Ví dụ: Đã gọi điện nhưng không nghe máy."></textarea><div class="form-text">Thời điểm liên hệ được hệ thống tự động ghi nhận.</div></div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button><button type="submit" class="btn btn-primary">Lưu liên hệ</button></div>
        </form>
    </div></div>
</div>

@section Scripts {
<script src="~/js/overdue-reader-export.js" asp-append-version="true"></script>
<script>
    document.querySelectorAll('.contact-button').forEach(function (button) {
        button.addEventListener('click', function () {
            document.getElementById('contactLoanId').value = button.dataset.loanId;
            document.getElementById('contactNote').value = '';
        });
    });
</script>
}
