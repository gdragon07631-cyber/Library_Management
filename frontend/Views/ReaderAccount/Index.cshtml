@model IReadOnlyList<Project.Models.ReaderAccount>
@using Project.Services
@{
    ViewData["Title"] = "Tài khoản bạn đọc";
    var query = ViewBag.Query as string;
    var status = ViewBag.Status as string;
    var limit = (int)ViewBag.Limit;
    var filters = new (string Value, string Label)[]
    {
        ("", "Tất cả"),
        ("Đang hoạt động", "Đang hoạt động"),
        ("Chờ duyệt", "Chờ duyệt"),
        ("Từ chối", "Từ chối"),
        (ReaderAccountFilters.CardLocked, "Thẻ thư viện bị khoá"),
        (ReaderAccountFilters.Locked, "Tài khoản bị khoá"),
        (ReaderAccountFilters.UnconfirmedEmail, "Chưa xác nhận email"),
        (ReaderAccountFilters.PendingEmailChange, "Đang chờ đổi email")
    };
}
<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 mb-1 text-primary fw-bold">Tài khoản bạn đọc</h1>
        <p class="text-muted mb-0">Quản lý và tra cứu tài khoản bạn đọc, khoá và mở khoá thẻ bạn đọc vi phạm mượn sách hoặc nợ phí.</p>
    </div>

    <div class="alert alert-info d-flex align-items-center justify-content-between mb-4">
        <div>
            <i class="bi bi-shield-exclamation me-2"></i>
            <strong>Đề xuất khoá thẻ tự động:</strong> Xem danh sách bạn đọc quá hạn trả sách trên 30 ngày hoặc nợ phí vượt ngưỡng quy định.
        </div>
        <a asp-controller="LoanPolicy" asp-action="Index" class="btn btn-sm btn-primary text-nowrap ms-3">Xem đề xuất khoá thẻ</a>
    </div>

    <form method="get" class="card shadow-sm border-0 mb-4" id="readerSearchForm">
        <div class="card-body row g-2 align-items-end">
            <div class="col-md-6">
                <label for="q" class="form-label small text-muted mb-1">Tìm kiếm</label>
                <input type="search" id="q" name="q" value="@query" class="form-control" placeholder="Họ tên, email, số điện thoại, mã SV/CB hoặc mã thẻ" />
            </div>
            <div class="col-md-4">
                <label for="status" class="form-label small text-muted mb-1">Trạng thái</label>
                <select id="status" name="status" class="form-select">
                    @foreach (var filter in filters)
                    {
                        <option value="@filter.Value" selected="@(string.Equals(filter.Value, status ?? "", StringComparison.Ordinal))">@filter.Label</option>
                    }
                </select>
            </div>
            <div class="col-md-2 d-grid">
                <button type="submit" class="btn btn-primary">Tìm</button>
            </div>
        </div>
    </form>

    <div class="card shadow-sm border-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" id="readerTable">
                <thead class="table-light">
                    <tr><th>#</th><th>Họ và tên</th><th>Email</th><th>Số điện thoại</th><th>Mã SV/CB</th><th>Thẻ</th><th>Tài khoản</th><th>Trạng thái thẻ</th><th class="text-end">Thao tác</th></tr>
                </thead>
                <tbody>
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="9" class="text-center text-muted py-4">Không tìm thấy tài khoản bạn đọc nào.</td></tr>
                    }
                    @foreach (var reader in Model)
                    {
                        var card = reader.LibraryCard;
                        var isCardLocked = card != null && LibraryCardStatusHelper.IsCardLocked(card, DateTime.UtcNow);
                        <tr>
                            <td class="text-muted">@reader.Id</td>
                            <td class="fw-semibold">@reader.FullName</td>
                            <td>
                                @reader.Email
                                @if (!reader.EmailConfirmed)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis ms-1">Chưa xác nhận</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(reader.PendingEmail))
                                {
                                    <div class="small text-muted">Chờ đổi sang: @reader.PendingEmail</div>
                                }
                            </td>
                            <td>@reader.PhoneNumber</td>
                            <td>@reader.StudentOrStaffCode</td>
                            <td>
                                @if (card is not null)
                                {
                                    <span class="font-monospace">@card.CardCode</span>
                                    <div class="small text-muted">@card.LibraryCardType?.Name · hết hạn @card.ExpiresOn.ToString("dd/MM/yyyy")</div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td>
                                <span class="badge @(reader.Status == "Đang hoạt động" ? "bg-success-subtle text-success-emphasis" : reader.Status == "Từ chối" ? "bg-danger-subtle text-danger-emphasis" : "bg-secondary-subtle text-secondary-emphasis")">@reader.Status</span>
                                @if (reader.IsLocked)
                                {
                                    <span class="badge bg-danger ms-1">Đã khoá</span>
                                }
                            </td>
                            <td>
                                @if (card is null)
                                {
                                    <span class="text-muted small">Chưa cấp thẻ</span>
                                }
                                else if (isCardLocked)
                                {
                                    <span class="badge bg-danger">Đang bị khoá</span>
                                    @if (!string.IsNullOrWhiteSpace(card.LockReason))
                                    {
                                        <div class="small text-danger text-truncate" style="max-width: 160px;" title="@card.LockReason">@card.LockReason</div>
                                    }
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success-emphasis">Đang hoạt động</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@reader.Id" class="btn btn-sm btn-outline-primary">Chi tiết</a>
                                @if (card is not null)
                                {
                                    if (isCardLocked)
                                    {
                                        <a asp-action="Details" asp-route-id="@reader.Id" asp-route-action="unlock" class="btn btn-sm btn-success ms-1">Mở khoá</a>
                                    }
                                    else
                                    {
                                        <a asp-action="Details" asp-route-id="@reader.Id" asp-route-action="lock" class="btn btn-sm btn-outline-danger ms-1">Khoá thẻ</a>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.Count >= limit)
        {
            <div class="card-footer small text-muted">Chỉ hiển thị @limit tài khoản mới nhất. Hãy nhập từ khoá để thu hẹp kết quả.</div>
        }
    </div>
</div>
