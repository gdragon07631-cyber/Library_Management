@model Project.Models.ReaderLoanHistoryPageViewModel
@{
    Layout = "_ReaderLayout";
    ViewData["Title"] = "Lịch sử mượn trả";
}
<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 mb-1 text-primary fw-bold">Phiếu mượn của tôi</h1>
        <p class="text-muted mb-0">Các sách bạn đã trả.</p>
    </div>
    <ul class="nav nav-tabs mb-3" aria-label="Phiếu mượn">
        <li class="nav-item"><a class="nav-link" asp-controller="ReaderLoan" asp-action="Index">Đang mượn</a></li>
        <li class="nav-item"><a class="nav-link active" aria-current="page" asp-controller="ReaderLoan" asp-action="History">Lịch sử đã trả</a></li>
    </ul>

    <div class="card shadow-sm border-0"><div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Sách</th><th>Mã vạch bản sao</th><th>Ngày mượn</th><th>Hạn trả</th><th>Ngày trả</th></tr></thead>
            <tbody>
            @if (Model.Loans.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có phiếu mượn đã trả.</td></tr> }
            @foreach (var loan in Model.Loans)
            {
                <tr>
                    <td>@loan.Book?.Title</td>
                    <td class="font-monospace">@(loan.BookCopy?.CopyCode ?? "—")</td>
                    <td>@loan.LoanDate.ToString("dd/MM/yyyy")</td>
                    <td>@loan.DueDate.ToString("dd/MM/yyyy")</td>
                    <td>@loan.ReturnedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy")</td>
                </tr>
            }
            </tbody>
        </table>
    </div></div>

    @if (Model.TotalPages > 1)
    {
        <nav class="mt-3" aria-label="Phân trang lịch sử phiếu mượn">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="History" asp-route-page="@(Model.Page - 1)" aria-label="Trang trước">Trước</a>
                </li>
                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.Page ? "active" : "")">
                        <a class="page-link" asp-action="History" asp-route-page="@pageNumber" aria-current="@(pageNumber == Model.Page ? "page" : null)">@pageNumber</a>
                    </li>
                }
                <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="History" asp-route-page="@(Model.Page + 1)" aria-label="Trang sau">Sau</a>
                </li>
            </ul>
        </nav>
        <p class="text-center text-muted small">Trang @Model.Page / @Model.TotalPages · @Model.TotalItems phiếu</p>
    }
</div>
