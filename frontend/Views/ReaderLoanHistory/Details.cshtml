@model Project.Models.ReaderLoanHistoryViewModel
@{
    ViewData["Title"] = "Lịch sử mượn trả";
}
<div class="container py-4">
    <a asp-controller="Loan" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-3">Quay lại phiếu mượn</a>
    <form asp-controller="ReaderLoanHistory" asp-action="Details" asp-route-id="@Model.Reader.Id" method="get" class="card card-body shadow-sm border-0 mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-sm-4">
                <label for="startDate" class="form-label">Từ ngày mượn</label>
                <input type="date" id="startDate" name="startDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-sm-4">
                <label for="endDate" class="form-label">Đến ngày mượn</label>
                <input type="date" id="endDate" name="endDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-sm-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Lọc</button>
                <a asp-controller="ReaderLoanHistory" asp-action="Details" asp-route-id="@Model.Reader.Id" class="btn btn-outline-secondary">Bỏ bộ lọc</a>
            </div>
        </div>
    </form>
    <form asp-controller="ReaderLoanHistory" asp-action="ExportCsv" asp-route-id="@Model.Reader.Id" method="get" class="mb-4">
        @if (Model.StartDate is { } startDate)
        {
            <input type="hidden" name="startDate" value="@startDate.ToString("yyyy-MM-dd")" />
        }
        @if (Model.EndDate is { } endDate)
        {
            <input type="hidden" name="endDate" value="@endDate.ToString("yyyy-MM-dd")" />
        }
        <button type="submit" class="btn btn-outline-primary" disabled="@(Model.DateFilterError is not null)">Xuất CSV</button>
    </form>
    @if (!string.IsNullOrWhiteSpace(Model.DateFilterError))
    {
        <div class="alert alert-danger" role="alert">@Model.DateFilterError</div>
    }
    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
        <h1 class="h3 fw-bold mb-0">Lịch sử mượn trả</h1>
        @if (Model.IsFrequentLateReturner)
        {
            <span id="frequentLateBadge" class="badge bg-warning text-dark fs-6">⚠ Thường xuyên trả trễ</span>
        }
    </div>
    <p class="text-muted">
        @Model.Reader.FullName · Mã bạn đọc: @Model.Reader.StudentOrStaffCode
        @if (Model.Reader.LibraryCard is { } card)
        {
            <span> · Mã thẻ: <strong class="font-monospace">@card.CardCode</strong></span>
        }
    </p>

    @if (Model.IsFrequentLateReturner && !string.IsNullOrWhiteSpace(Model.FrequentLateWarningMessage))
    {
        <div id="frequentLateWarningAlert" class="alert alert-warning border-warning d-flex align-items-start gap-2 mb-4" role="alert">
            <span class="fs-4 lh-1" aria-hidden="true">⚠</span>
            <div>
                <div class="fw-bold">Cảnh báo: Bạn đọc thường xuyên trả trễ</div>
                <div>@Model.FrequentLateWarningMessage</div>
            </div>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-sm-4"><div class="card h-100"><div class="card-body"><div class="text-muted small">Phiếu đang mở</div><div class="fs-3 fw-bold">@Model.OpenLoanCount</div>@if (Model.OverdueOpenLoanCount > 0) { <div class="small text-danger fw-semibold">Đang quá hạn: @Model.OverdueOpenLoanCount phiếu</div> }</div></div></div>
        <div class="col-sm-4"><div class="card h-100"><div class="card-body"><div class="text-muted small">Tổng lượt mượn</div><div class="fs-3 fw-bold">@Model.TotalLoanCount</div></div></div></div>
        <div class="col-sm-4">
            <div class="card h-100 @(Model.IsFrequentLateReturner ? "border-warning bg-warning-subtle" : "")">
                <div class="card-body">
                    <div class="text-muted small">Lượt trả trễ</div>
                    <div class="fs-3 fw-bold @(Model.LateReturnCount > 0 ? "text-warning-emphasis" : "")">@Model.LateReturnCount</div>
                    <div class="small text-muted">
                        Tính theo ngày trả thực tế tại Việt Nam muộn hơn hạn trả.
                        @if (Model.AllTimeTotalLoanCount > 0)
                        {
                            <span class="d-block mt-1 fw-semibold @(Model.IsFrequentLateReturner ? "text-danger" : "")">
                                Tỷ lệ trễ toàn kỳ: @Model.LateReturnRate.ToString("0.#")% (@Model.AllTimeLateReturnCount/@Model.AllTimeTotalLoanCount lượt trả trễ@(Model.AllTimeOverdueOpenLoanCount > 0 ? $", {Model.AllTimeOverdueOpenLoanCount} đang quá hạn" : ""))
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white"><h2 class="h5 mb-0">Phiếu mượn</h2></div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Mã phiếu</th><th>Sách</th><th>Mã vạch bản sao</th><th>Ngày mượn</th><th>Hạn trả</th><th>Ngày trả thực tế</th><th>Trạng thái</th></tr></thead>
                <tbody>
                @if (Model.Loans.Count == 0)
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">@(Model.IsFiltered ? "Không có phiếu mượn trong khoảng ngày đã chọn." : "Bạn đọc chưa có phiếu mượn nào.")</td></tr>
                }
                @foreach (var loan in Model.Loans)
                {
                    var isIncidentClosed = loan.CloseReason is Project.Models.BookLoanCloseReason.Lost or Project.Models.BookLoanCloseReason.Damaged;
                    var returnedDate = Project.Models.ReaderLoanHistoryViewModel.GetLocalReturnDate(loan);
                    var isReturned = (loan.ReturnedAtUtc.HasValue || loan.ReturnDate.HasValue) && !isIncidentClosed;
                    var isLateReturn = Project.Models.ReaderLoanHistoryViewModel.IsLateReturn(loan);
                    var isOverdue = !isReturned && !isIncidentClosed && loan.DueDate < Project.Services.HoldPickupExpirySchedule.GetBusinessDate(DateTime.UtcNow);
                    var loanStatus = loan.CloseReason switch
                    {
                        Project.Models.BookLoanCloseReason.Lost => "Đã đóng - mất",
                        Project.Models.BookLoanCloseReason.Damaged => "Đã đóng - hỏng nặng",
                        _ => isReturned
                            ? isLateReturn ? "Đã trả trễ hạn" : "Đã trả đúng hạn"
                            : isOverdue ? "Quá hạn, chưa trả" : "Đang mượn"
                    };
                    var badgeClass = loan.CloseReason is Project.Models.BookLoanCloseReason.Lost or Project.Models.BookLoanCloseReason.Damaged
                        ? "bg-secondary"
                        : isLateReturn
                            ? "bg-warning text-dark"
                            : isOverdue
                                ? "bg-danger"
                                : isReturned
                                    ? "bg-success-subtle text-success-emphasis"
                                    : "bg-primary-subtle text-primary-emphasis";
                    <tr class="@(isLateReturn || isOverdue ? "table-warning" : "")">
                        <td>#@loan.Id</td>
                        <td>@loan.Book?.Title</td>
                        <td>@(loan.BookCopy?.CopyCode ?? "—")</td>
                        <td>@loan.LoanDate.ToString("dd/MM/yyyy")</td>
                        <td>@loan.DueDate.ToString("dd/MM/yyyy")</td>
                        <td>@(returnedDate?.ToString("dd/MM/yyyy") ?? "—")</td>
                        <td><span class="badge @badgeClass">@loanStatus</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

