@model Project.Models.ReaderProfileViewModel
@{
    Layout = "_ReaderLayout";
    ViewData["Title"] = "Thông tin tài khoản Bạn đọc";
    // Viết qua biến vì "@@" bên trong thuộc tính của tag helper bị Razor sinh sai HTML.
    const string EmailPattern = @"[^@\s]+@[^@\s]+\.[^@\s]+";
    var nameParts = (Model.FullName ?? string.Empty).Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initial = nameParts.Length == 0 ? "B" : nameParts[^1][..1].ToUpperInvariant();
    var isPending = string.Equals(Model.Status, "Chờ duyệt", StringComparison.OrdinalIgnoreCase);
    var isRejected = string.Equals(Model.Status, "Từ chối", StringComparison.OrdinalIgnoreCase);
    var isActive = string.Equals(Model.Status, "Đang hoạt động", StringComparison.OrdinalIgnoreCase);
    var card = Model.LibraryCard;
    var isCardLocked = card is not null && LibraryCardStatusHelper.IsCardLocked(card);
    var cardLockMessage = card is null ? string.Empty : LibraryCardStatusHelper.GetLockMessage(card);
    var cardLockStartUtc = card?.LockedAtUtc?.ToLocalTime();
    var cardLockExpiresUtc = card?.LockExpiresAtUtc?.ToLocalTime();
    var cardIsManualUnlock = card is not null && (card.IsLockUntilManualUnlock || !card.LockExpiresAtUtc.HasValue);
}

<section class="rd-hero">
    <div class="rd-profile-head">
        <div class="rd-avatar" aria-hidden="true">@initial</div>
        <div class="flex-grow-1">
            <div class="rd-eyebrow">Tài khoản Bạn đọc</div>
            <h1>@Model.FullName</h1>
            <div class="rd-profile-meta">
                <span><i class="bi bi-envelope"></i>@Model.Email</span>
                <span><i class="bi bi-telephone"></i>@Model.PhoneNumber</span>
                <span><i class="bi bi-person-vcard"></i>@Model.StudentOrStaffCode</span>
                <span><i class="bi bi-calendar-heart"></i>@Model.DateOfBirth.ToString("dd/MM/yyyy")</span>
            </div>
        </div>
        <div id="accountStatusDisplay">
            @if (isPending)
            {
                <span class="rd-pill is-pending"><i class="bi bi-hourglass-split"></i> Chờ duyệt</span>
            }
            else if (isRejected)
            {
                <span class="rd-pill is-rejected"><i class="bi bi-x-circle"></i> Từ chối</span>
            }
            else
            {
                <span class="rd-pill is-active"><i class="bi bi-check-circle"></i> @Model.Status</span>
            }
        </div>
    </div>
</section>

@if (TempData["HoldErrorMessage"] != null)
{
    <div class="alert alert-danger mb-4" role="alert">
        <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>Không thể đặt giữ:</strong>
        @TempData["HoldErrorMessage"]
    </div>
}
@if (TempData["HoldSuccessMessage"] != null)
{
    <div class="alert alert-success mb-4" role="alert">
        <strong><i class="bi bi-check-circle-fill me-2"></i>Thành công:</strong>
        @TempData["HoldSuccessMessage"]
    </div>
}
@if (TempData["ProfileSuccessMessage"] != null)
{
    <div class="alert alert-success mb-4" role="status"><i class="bi bi-check-circle-fill me-2"></i>@TempData["ProfileSuccessMessage"]</div>
}
@if (TempData["DevConfirmLink"] is string devConfirmLink)
{
    <div class="rd-dev-link mb-4" id="devConfirmLink">Chưa gửi được email (môi trường phát triển). Liên kết xác nhận: <a href="@devConfirmLink">@devConfirmLink</a></div>
}

@if (isPending)
{
    <div class="alert alert-warning mb-4" role="alert">
        <strong><i class="bi bi-info-circle-fill me-2"></i>Tài khoản chưa được kích hoạt.</strong>
        Bạn chưa thể đặt giữ tài liệu. Vui lòng liên hệ quầy thư viện (mang theo thẻ sinh viên / thẻ cán bộ hoặc CCCD) để được hỗ trợ kích hoạt.
    </div>
}
else if (isRejected)
{
    <div class="alert alert-danger mb-4" role="alert">
        <strong><i class="bi bi-x-octagon-fill me-2"></i>Hồ sơ của bạn đã bị từ chối.</strong>
        <span class="d-block mt-1"><strong>Lý do từ chối:</strong> @Model.RejectionReason</span>
    </div>
}

<div class="row g-4">
    <div class="col-lg-5 col-xl-4">
        @if (Model.CardCode != null)
        {
            <div class="library-card mb-4">
                <div class="library-card-top">
                    <div class="library-card-brand">Thư Viện<small>@(Model.CardType ?? "Thẻ thư viện")</small></div>
                    <div class="library-card-chip" aria-hidden="true"></div>
                </div>
                <div class="library-card-code">@Model.CardCode</div>
                <div class="library-card-bottom">
                    <div><span>Chủ thẻ</span><strong>@Model.FullName</strong></div>
                    <div><span>Hết hạn</span><strong>@Model.CardExpiresOn?.ToString("dd/MM/yyyy")</strong></div>
                </div>
            </div>
            <div class="rd-card mb-4">
                <div class="rd-card-body py-3">
                    <dl class="rd-info-list">
                        <div><dt>Loại thẻ</dt><dd>@Model.CardType</dd></div>
                        <div><dt>Ngày hết hạn thẻ</dt><dd>@Model.CardExpiresOn?.ToString("dd/MM/yyyy")</dd></div>
                        <div><dt>Trạng thái thẻ</dt><dd>@(Model.CardStatus ?? "Đang hoạt động")</dd></div>
                    </dl>
                </div>
            </div>

            <div class="rd-card mb-4">
                <div class="rd-card-body py-3">
                    <h2 class="rd-card-title"><span class="rd-icon-chip is-gold"><i class="bi bi-shield-lock"></i></span><span>Thông tin khoá thẻ</span></h2>
                    @if (isCardLocked)
                    {
                        <div class="alert alert-danger mb-3" role="alert">
                            <strong>Đang bị khoá.</strong>
                            @if (!string.IsNullOrWhiteSpace(cardLockMessage))
                            {
                                <div class="mt-2">@cardLockMessage</div>
                            }
                        </div>
                        <dl class="rd-info-list mb-0">
                            <div><dt>Lý do khoá</dt><dd>@(!string.IsNullOrWhiteSpace(card?.LockReason) ? card.LockReason : "Không có lý do cụ thể.")</dd></div>
                            <div><dt>Thời điểm bắt đầu</dt><dd>@(cardLockStartUtc?.ToString("dd/MM/yyyy HH:mm") ?? "Không có thông tin")</dd></div>
                            @if (cardIsManualUnlock)
                            {
                                <div><dt>Thời hạn</dt><dd>Khoá đến khi được mở khoá thủ công.</dd></div>
                            }
                            else
                            {
                                <div><dt>Thời hạn</dt><dd>@(cardLockExpiresUtc?.ToString("dd/MM/yyyy HH:mm") ?? "Không có thông tin")</dd></div>
                            }
                        </dl>
                    }
                    else
                    {
                        <div class="alert alert-success mb-0" role="alert">
                            <strong>Đang hoạt động.</strong>
                            <div class="mt-2">Thẻ bạn đọc hiện không bị khoá và có thể sử dụng các dịch vụ thư viện bình thường.</div>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="library-card is-empty mb-4">
                <div>
                    <i class="bi bi-credit-card-2-front fs-1 d-block mb-2"></i>
                    <strong>Chưa có thẻ thư viện</strong>
                    <div class="small mt-1">Thẻ được cấp khi tài khoản được kích hoạt.</div>
                </div>
            </div>
        }

        <div class="rd-card">
            <div class="rd-card-body">
                <h2 class="rd-card-title"><span class="rd-icon-chip is-gold"><i class="bi bi-bookmark-plus"></i></span><span>Đặt giữ tài liệu<small>Nhập mã sách hoặc chọn từ trang tra cứu</small></span></h2>
                @if (isActive)
                {
                    <form asp-action="HoldDocument" method="post" class="rd-form mb-3">
                        <label for="documentId" class="form-label">Mã tài liệu</label>
                        <div class="d-flex gap-2">
                            <input type="number" id="documentId" name="documentId" class="form-control" placeholder="Ví dụ: 12" min="1" required />
                            <button type="submit" class="btn btn-primary" id="btnHoldDocument">Đặt giữ</button>
                        </div>
                    </form>
                }
                else
                {
                    <p class="text-muted small">Chỉ tài khoản đang hoạt động mới có thể đặt giữ tài liệu.</p>
                }
                <div class="rd-quick-links">
                    <a class="rd-quick-link" asp-controller="Catalog" asp-action="Index">
                        <span class="rd-icon-chip"><i class="bi bi-search"></i></span>
                        <span>Tra cứu sách<small>Tìm theo tên, tác giả, thể loại</small></span>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                    <a class="rd-quick-link" asp-controller="ReaderLoan" asp-action="Index">
                        <span class="rd-icon-chip"><i class="bi bi-journal-check"></i></span>
                        <span>Phiếu mượn của tôi<small>Xem sách đang mượn & gia hạn</small></span>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                    <a class="rd-quick-link" asp-action="MyHolds">
                        <span class="rd-icon-chip is-green"><i class="bi bi-bookmark-star"></i></span>
                        <span>Đơn đặt giữ của tôi<small>Xem hàng đợi, hạn nhận, hủy đơn</small></span>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-7 col-xl-8">
        <div class="rd-card mb-4">
            <div class="rd-card-body">
                <h2 class="rd-card-title"><span class="rd-icon-chip"><i class="bi bi-person-lines-fill"></i></span><span>Thông tin liên hệ<small>Họ tên, ngày sinh và mã thẻ do thư viện quản lý</small></span></h2>
                <form asp-action="Profile" method="post" id="profileForm" class="rd-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label">Họ và tên</label>
                            <input class="form-control" value="@Model.FullName" readonly />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Ngày sinh</label>
                            <input class="form-control" value="@Model.DateOfBirth.ToString("dd/MM/yyyy")" readonly />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Mã thẻ</label>
                            <input class="form-control" value="@Model.CardCode" readonly />
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label">Địa chỉ</label>
                            <input asp-for="Address" class="form-control" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" type="email" pattern="@EmailPattern" class="form-control" data-initial-email="@Model.Email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                            @if (!string.IsNullOrWhiteSpace(Model.PendingEmail))
                            {
                                <div class="form-text text-warning-emphasis" id="pendingEmailNotice"><i class="bi bi-hourglass-split me-1"></i>Đang chờ xác nhận email mới <strong>@Model.PendingEmail</strong>. Hãy bấm liên kết trong email gửi tới địa chỉ đó; trước khi xác nhận, bạn vẫn đăng nhập bằng email hiện tại.</div>
                            }
                        </div>
                        <div class="col-12" id="currentPasswordContainer" hidden>
                            <label asp-for="CurrentPassword" class="form-label">Mật khẩu hiện tại</label>
                            <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
                            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                            <div class="form-text">Cần nhập khi đổi email để bảo vệ tài khoản.</div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mt-4"><i class="bi bi-check2"></i> Lưu thay đổi</button>
                </form>
            </div>
        </div>

        <div class="rd-card">
            <div class="rd-card-body">
                <h2 class="rd-card-title"><span class="rd-icon-chip is-red"><i class="bi bi-shield-lock"></i></span><span>Đổi mật khẩu<small>Không được trùng với 3 mật khẩu gần nhất</small></span></h2>
                @if (TempData["PasswordSuccessMessage"] != null)
                {
                    <div class="alert alert-success" role="status">@TempData["PasswordSuccessMessage"]</div>
                }
                @if (TempData["PasswordErrorMessage"] != null)
                {
                    <div class="alert alert-danger" role="alert">@TempData["PasswordErrorMessage"]</div>
                }
                <form asp-action="ChangePassword" method="post" id="changePasswordForm" class="rd-form">
                    <div class="row g-3">
                        <div class="col-12">
                            <label for="changeCurrentPassword" class="form-label">Mật khẩu cũ</label>
                            <div class="login-input-group">
                                <i class="bi bi-lock login-input-icon" aria-hidden="true"></i>
                                <input type="password" id="changeCurrentPassword" name="CurrentPassword" class="form-control" autocomplete="current-password" required />
                                <button type="button" class="login-password-toggle" data-password-toggle="changeCurrentPassword" aria-label="Hiện mật khẩu" aria-pressed="false" tabindex="-1"><i class="bi bi-eye"></i></button>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label for="newPassword" class="form-label">Mật khẩu mới</label>
                            <div class="login-input-group">
                                <i class="bi bi-key login-input-icon" aria-hidden="true"></i>
                                <input type="password" id="newPassword" name="NewPassword" class="form-control" autocomplete="new-password" required />
                                <button type="button" class="login-password-toggle" data-password-toggle="newPassword" aria-label="Hiện mật khẩu" aria-pressed="false" tabindex="-1"><i class="bi bi-eye"></i></button>
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <label for="confirmNewPassword" class="form-label">Nhập lại mật khẩu mới</label>
                            <div class="login-input-group">
                                <i class="bi bi-shield-check login-input-icon" aria-hidden="true"></i>
                                <input type="password" id="confirmNewPassword" name="ConfirmNewPassword" class="form-control" autocomplete="new-password" required />
                                <button type="button" class="login-password-toggle" data-password-toggle="confirmNewPassword" aria-label="Hiện mật khẩu" aria-pressed="false" tabindex="-1"><i class="bi bi-eye"></i></button>
                            </div>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-outline-primary mt-4"><i class="bi bi-arrow-repeat"></i> Đổi mật khẩu</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById("profileForm");
            const email = document.getElementById("Email");
            const password = document.getElementById("CurrentPassword");
            const passwordContainer = document.getElementById("currentPasswordContainer");
            if (!form || !email || !password || !passwordContainer) return;

            const originalEmail = (email.dataset.initialEmail || "").trim().toLowerCase();
            const emailChanged = () => email.value.trim().toLowerCase() !== originalEmail;
            const updatePasswordVisibility = () => {
                passwordContainer.hidden = !emailChanged();
            };

            email.addEventListener("input", updatePasswordVisibility);
            updatePasswordVisibility();
            form.addEventListener("submit", event => {
                if (emailChanged() && !password.value.trim()) {
                    event.preventDefault();
                    passwordContainer.hidden = false;
                    password.setCustomValidity("Vui lòng nhập mật khẩu hiện tại.");
                    password.reportValidity();
                } else {
                    password.setCustomValidity("");
                }
            });
            password.addEventListener("input", () => password.setCustomValidity(""));
        })();
    </script>
    <script>
        (() => {
            const form = document.getElementById("changePasswordForm");
            const newPassword = document.getElementById("newPassword");
            const confirmation = document.getElementById("confirmNewPassword");
            if (!form || !newPassword || !confirmation) return;

            const validateConfirmation = () => {
                confirmation.setCustomValidity(
                    confirmation.value && confirmation.value !== newPassword.value
                        ? "Mật khẩu mới và mật khẩu xác nhận không trùng khớp."
                        : "");
            };
            newPassword.addEventListener("input", validateConfirmation);
            confirmation.addEventListener("input", validateConfirmation);
            form.addEventListener("submit", event => {
                validateConfirmation();
                if (!form.reportValidity()) event.preventDefault();
            });
        })();
    </script>
}
