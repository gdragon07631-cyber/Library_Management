                <a class="side-link @Active("LoanPolicy")" aria-current="@Current("LoanPolicy")" asp-controller="LoanPolicy" asp-action="Index"><span>⚙</span> Chính sách mượn</a>
                <a class="side-link @Active("CompensationPolicy")" aria-current="@Current("CompensationPolicy")" asp-controller="CompensationPolicy" asp-action="Index"><span>⚙</span> Hệ số bồi thường</a>
