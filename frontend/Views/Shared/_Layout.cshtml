            @if (isAdmin)
            {
                <a class="side-link @Active("StaffAccount")" aria-current="@Current("StaffAccount")" asp-controller="StaffAccount" asp-action="Index"><span>☺</span> Tài khoản nhân sự</a>
                <a class="side-link @Active("ReaderAccount")" aria-current="@Current("ReaderAccount")" asp-controller="ReaderAccount" asp-action="Index"><span>☻</span> Tài khoản bạn đọc</a>
                <a class="side-link @Active("PermissionMatrix")" aria-current="@Current("PermissionMatrix")" asp-controller="PermissionMatrix" asp-action="Index"><span>⊞</span> Ma trận phân quyền</a>
            }
            @if (canViewAuditLogs)
            {
                <a class="side-link @Active("AuditLog")" aria-current="@Current("AuditLog")" asp-controller="AuditLog" asp-action="Index"><span>☰</span> Nhật ký hoạt động</a>
            }
            @if (role == AccountRoles.LibraryManager)
            {
                <a class="side-link @Active("FeeWaiverReview")" aria-current="@Current("FeeWaiverReview")" asp-controller="FeeWaiverReview" asp-action="Index"><span>✓</span> Duyệt miễn giảm</a>
            }
            @if (isLibrarian)
            {
                <a class="side-link @Active("FeeWaiver")" aria-current="@Current("FeeWaiver")" asp-controller="FeeWaiver" asp-action="Index"><span>↗</span> Đề nghị miễn giảm</a>
            }            <div class="sidebar-bottom"><span class="status-dot"></span> Hệ thống đang hoạt động</div>
        </aside>

        <div class="main-shell">
            <header class="topbar">
                <div class="breadcrumb">Thư viện <span>/</span> @ViewData["Title"]</div>
                @if (staff is not null)
                {
                    <div class="topbar-user">
                        <span class="admin-link" title="@staff.Email"><span class="admin-avatar">@(displayName![..1].ToUpperInvariant())</span> <span><strong class="d-block lh-sm">@displayName</strong><small class="text-muted">@AccountRoles.DisplayName(staff.Role)</small></span></span>
                        <form asp-controller="Account" asp-action="Logout" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-secondary topbar-logout" title="Đăng xuất khỏi hệ thống"><span aria-hidden="true">⎋</span> Đăng xuất</button>
                        </form>
                    </div>
                }
                else
                {
                    <a class="admin-link" asp-controller="Account" asp-action="Login"><span class="admin-avatar">Q</span> Đăng nhập nhân sự <span class="caret">⌄</span></a>
                }
            </header>
            <main class="page-content" role="main">@RenderBody()</main>
            <footer class="page-footer">© 2026 Thư viện · Hệ thống quản lý nội bộ</footer>
