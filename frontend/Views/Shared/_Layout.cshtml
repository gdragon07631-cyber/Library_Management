@inject Project.Services.IAuditLogService AuditLogAccess
@using Project.Models
@{
    var staff = await AuditLogAccess.GetSignedInStaffAsync(Context.Request);
    var role = staff?.Role;
    var canViewAuditLogs = Project.Services.AuditLogService.CanViewLogs(staff);
    var isAdmin = role == AccountRoles.SystemAdmin;
    var canManageLibrary = role is AccountRoles.SystemAdmin or AccountRoles.LibraryManager;
    var isLibrarian = role == AccountRoles.Librarian;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "active" : "";
    string? Current(string controller) => string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase) ? "page" : null;
    var displayName = staff is null ? null : string.IsNullOrWhiteSpace(staff.FullName) ? staff.Email : staff.FullName;
}
